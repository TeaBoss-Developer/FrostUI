<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FrostUI</AssemblyName>
    <RootNamespace>FrostUI</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>TeaBoss</Authors>
    <Company>FrostUI</Company>
    <Description>A frosted-glass UI kit for WPF with real Windows Acrylic / Mica backdrops.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- NuGet packaging -->
    <PackageId>FrostUI</PackageId>
    <PackageTags>wpf;acrylic;mica;glass;glassmorphism;ui;theme;windows</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/TeaBoss-Developer/FrostUI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/TeaBoss-Developer/FrostUI</PackageProjectUrl>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <PackageReleaseNotes>WPF 1.0.0 — FrostWindow, GlassCard, glass controls, dual themes and runtime accents.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.nuget.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
