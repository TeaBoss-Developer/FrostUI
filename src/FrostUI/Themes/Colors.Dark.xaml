<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Typography -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F7FD" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAB6CB" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#748198" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#4E596B" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#07101F" />

    <!-- Window surfaces -->
    <LinearGradientBrush x:Key="WindowSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5C0B1220" Offset="0" />
        <GradientStop Color="#33070B14" Offset="0.55" />
        <GradientStop Color="#4D0C1220" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FallbackWindowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FC0B101B" Offset="0" />
        <GradientStop Color="#FF070A12" Offset="0.62" />
        <GradientStop Color="#FF0B0E18" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WindowEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4DFFFFFF" Offset="0" />
        <GradientStop Color="#12FFFFFF" Offset="0.38" />
        <GradientStop Color="#08FFFFFF" Offset="0.7" />
        <GradientStop Color="#26FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WindowOverlayBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#14FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.35" />
        <GradientStop Color="#0A6F9CFF" Offset="0.77" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>

    <!-- Chrome -->
    <SolidColorBrush x:Key="TitleBarBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="TitleBarBorderBrush" Color="#12FFFFFF" />
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3D050A12" Offset="0" />
        <GradientStop Color="#24050A11" Offset="0.55" />
        <GradientStop Color="#33060A12" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DividerBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="CaptionButtonPressedBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#D9433A" />

    <!-- Material -->
    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1FFFFFFF" Offset="0" />
        <GradientStop Color="#10FFFFFF" Offset="0.48" />
        <GradientStop Color="#0AFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardHoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2BFFFFFF" Offset="0" />
        <GradientStop Color="#17FFFFFF" Offset="0.5" />
        <GradientStop Color="#0FFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardSheenBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#80FFFFFF" Offset="0.24" />
        <GradientStop Color="#38FFFFFF" Offset="0.55" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38FFFFFF" Offset="0" />
        <GradientStop Color="#0DFFFFFF" Offset="0.4" />
        <GradientStop Color="#0AFFFFFF" Offset="0.7" />
        <GradientStop Color="#1FFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="CardBorderStrongBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="CardShadowBrush" Color="#66000000" />
    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2E84AEFF" Offset="0" />
        <GradientStop Color="#16B79CFF" Offset="0.5" />
        <GradientStop Color="#0DFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="InsetSurfaceBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="InsetSurfaceStrongBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ChipBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ChipBorderBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="InputBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="InputFocusBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ToastBrush" Color="#F20A101B" />
    <SolidColorBrush x:Key="ToolTipBrush" Color="#F20D1421" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#3384AEFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="SkeletonBrush" Color="#14FFFFFF" />

    <!-- Navigation -->
    <SolidColorBrush x:Key="NavHoverBrush" Color="#0EFFFFFF" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="NavSelectedBorderBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="NavGlyphBrush" Color="#91A0B8" />
    <SolidColorBrush x:Key="NavGlyphSelectedBrush" Color="#EAF1FF" />

    <!-- Accent (ThemeManager replaces these at runtime) -->
    <Color x:Key="AccentColor">#84AEFF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#84AEFF" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#5E82F5" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E84AEFF" />
    <SolidColorBrush x:Key="TextSelectionBrush" Color="#FF84AEFF" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#5584AEFF" />
    <SolidColorBrush x:Key="AccentTrackBrush" Color="#3384AEFF" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#4D84AEFF" />
    <SolidColorBrush x:Key="AccentContrastBrush" Color="#07101F" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8FB8FF" Offset="0" />
        <GradientStop Color="#B79CFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9BC2FF" Offset="0" />
        <GradientStop Color="#C7A6FF" Offset="0.55" />
        <GradientStop Color="#7AE8D8" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AvatarGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7AA7FF" Offset="0" />
        <GradientStop Color="#C4A1FF" Offset="1" />
    </LinearGradientBrush>

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#63E6BE" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2E63E6BE" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFC46B" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#2EFFC46B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF7E94" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#2EFF7E94" />
    <SolidColorBrush x:Key="InfoBrush" Color="#8FB8FF" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#2E8FB8FF" />

    <!-- Ambient light -->
    <RadialGradientBrush x:Key="AmbientBlueBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#5C5B8FFF" Offset="0" />
        <GradientStop Color="#245B8FFF" Offset="0.55" />
        <GradientStop Color="#005B8FFF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AmbientVioletBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#4DBB85FF" Offset="0" />
        <GradientStop Color="#1ABB85FF" Offset="0.55" />
        <GradientStop Color="#00BB85FF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AmbientTealBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#3D5FE3C9" Offset="0" />
        <GradientStop Color="#155FE3C9" Offset="0.55" />
        <GradientStop Color="#005FE3C9" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="OrbBrush" Center="0.35,0.3" GradientOrigin="0.35,0.3" RadiusX="0.7" RadiusY="0.7">
        <GradientStop Color="#CCB9D3FF" Offset="0" />
        <GradientStop Color="#9984AEFF" Offset="0.36" />
        <GradientStop Color="#4D5E82F5" Offset="0.68" />
        <GradientStop Color="#005E82F5" Offset="1" />
    </RadialGradientBrush>

    <!-- Effects -->
    <DropShadowEffect x:Key="CardShadowEffect" BlurRadius="30" ShadowDepth="8" Direction="270"
                      Color="#A0000000" Opacity="0.28" RenderingBias="Quality" />
    <DropShadowEffect x:Key="FloatingShadowEffect" BlurRadius="36" ShadowDepth="18" Direction="270"
                      Color="#C0000000" Opacity="0.4" RenderingBias="Quality" />
    <DropShadowEffect x:Key="SoftGlowEffect" BlurRadius="26" ShadowDepth="0"
                      Color="#6684AEFF" Opacity="0.45" RenderingBias="Quality" />

    <!-- Brushes shared by the built-in styles -->
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BlackBrush" Color="#000000" />

</ResourceDictionary>
