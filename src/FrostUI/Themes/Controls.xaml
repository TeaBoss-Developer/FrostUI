    </Style>

    <!-- ============================================================
         Toggle switch
         ============================================================ -->
    <Style x:Key="GlassToggleSwitchStyle" TargetType="{x:Type local:GlassToggleSwitch}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:GlassToggleSwitch}">
                    <Grid Width="44" Height="24">
                        <Border x:Name="Track" CornerRadius="12"
                                Background="{DynamicResource InsetSurfaceStrongBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" />
                        <Border x:Name="TrackGlow" CornerRadius="12"
                                Background="{DynamicResource AccentGlowBrush}"
                                Opacity="0" />
                        <Grid x:Name="ThumbHost" Width="20" Height="20"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="2,0,0,0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="ThumbTransform" X="0" />
                            </Grid.RenderTransform>
                            <Ellipse x:Name="Halo" Fill="{DynamicResource AccentGlowBrush}" Opacity="0" />
                            <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8"
                                    Background="#F2FFFFFF">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Direction="270"
                                                      Color="#66000000" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background"
                                    Value="{DynamicResource AccentGradientBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush"
                                    Value="{DynamicResource AccentBorderBrush}" />
                            <Setter TargetName="TrackGlow" Property="Opacity" Value="0.35" />
                            <Setter TargetName="Halo" Property="Opacity" Value="0.7" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="20" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush"
                                    Value="{DynamicResource AccentBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                            <Setter TargetName="ThumbHost" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:GlassToggleSwitch}" BasedOn="{StaticResource GlassToggleSwitchStyle}" />

    <!-- ============================================================
         Radio pills
         ============================================================ -->
    <Style x:Key="GlassRadioButtonStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="Root" CornerRadius="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource InsetSurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource AccentBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Glass card
         ============================================================ -->
    <Style x:Key="GlassCardStyle" TargetType="{x:Type local:GlassCard}">
        <Setter Property="Padding" Value="18" />
        <Setter Property="Background" Value="{DynamicResource CardGradientBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:GlassCard}">
                    <Grid>
                        <Border x:Name="Aura"
                                Margin="10,12,10,0"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{DynamicResource AccentSoftBrush}"
                                Effect="{DynamicResource SoftGlowEffect}"
                                Opacity="0.7"
                                Visibility="Collapsed" />
                        <Border x:Name="Shadow"
                                Margin="8,12,8,-2"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{DynamicResource CardShadowBrush}"
                                Effect="{DynamicResource CardShadowEffect}"
                                Visibility="Collapsed" />
                        <Border x:Name="Surface"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border CornerRadius="{TemplateBinding CornerRadius}"
                                        Background="{x:Static media:FrostMaterials.NoiseBrush}"
                                        Opacity="0.026"
                                        IsHitTestVisible="False" />
                                <Border Height="1" Margin="18,0,18,0" VerticalAlignment="Top"
                                        Background="{DynamicResource CardSheenBrush}"
                                        Opacity="0.62"
                                        IsHitTestVisible="False" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                                <Border CornerRadius="{TemplateBinding CornerRadius}"
                                        BorderBrush="{DynamicResource CardEdgeBrush}"
                                        BorderThickness="1"
                                        IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsInteractive" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Surface" Property="Background"
                                    Value="{DynamicResource CardHoverGradientBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsInteractive" Value="True">
                            <Setter Property="Cursor" Value="Hand" />
                        </Trigger>
                        <Trigger Property="HasShadow" Value="True">
                            <Setter TargetName="Shadow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Glow" Value="True">
                            <Setter TargetName="Aura" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:GlassCard}" BasedOn="{StaticResource GlassCardStyle}" />

