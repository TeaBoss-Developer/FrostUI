<local:FrostWindow x:Class="FrostUI.Demo.MainWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:FrostUI.Controls;assembly=FrostUI"
                   xmlns:views="clr-namespace:FrostUI.Demo.Views"
                   Title="FrostUI"
                   Width="1320" Height="850"
                   MinWidth="1120" MinHeight="720"
                   WindowStartupLocation="CenterScreen"
                   Style="{StaticResource FrostWindowStyle}"
                   Backdrop="Acrylic"
                   TintOpacity="0.28"
                   FontFamily="{DynamicResource UiFont}">

    <local:FrostWindow.Resources>
        <DataTemplate x:Key="NavItemTemplate">
            <Grid Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Glyph"
                           Text="{Binding Icon}"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="13"
                           Foreground="{DynamicResource NavGlyphBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Title}"
                           Margin="5,0,0,0"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" />
                <Border Grid.Column="2"
                        CornerRadius="5"
                        Padding="5,2"
                        Background="{DynamicResource AccentSoftBrush}"
                        Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Badge}"
                               FontSize="7.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                             Value="True">
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </local:FrostWindow.Resources>

    <local:FrostWindow.TitleBarContent>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Border x:Name="SearchShell"
                    Width="354" Height="30"
                    CornerRadius="9"
                    Background="{DynamicResource InputBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1">
                <Grid Margin="9,0,7,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;"
                               FontFamily="{DynamicResource IconFont}"
                               FontSize="10.5"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center" />
                    <Grid Grid.Column="1" Margin="4,0,4,0">
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 VerticalAlignment="Center"
                                 TextChanged="SearchBox_OnTextChanged"
                                 GotKeyboardFocus="SearchBox_OnGotKeyboardFocus"
                                 LostKeyboardFocus="SearchBox_OnLostKeyboardFocus"
                                 KeyDown="SearchBox_OnKeyDown" />
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="搜索组件、样式或文档"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                    <Border Grid.Column="2"
                            Background="{DynamicResource InsetSurfaceBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="4,1"
                            VerticalAlignment="Center">
                        <TextBlock Text="Ctrl K"
                                   FontFamily="{DynamicResource MonoFont}"
                                   FontSize="8"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Border>
                </Grid>
            </Border>

            <Button x:Name="ThemeButton"
                    Style="{StaticResource IconButtonStyle}"
                    Width="30" Height="30"
                    Margin="8,0,0,0"
                    ToolTip="切换深色 / 浅色主题"
                    Click="ThemeButton_OnClick">
                <TextBlock x:Name="ThemeGlyph" Text="&#xE706;"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="12" />
            </Button>
        </StackPanel>
    </local:FrostWindow.TitleBarContent>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="14,18,14,13">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="10,0,8,0">
                    <TextBlock Text="工 作 区" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="4 MODULES"
                               Style="{StaticResource EyebrowTextStyle}"
                               FontSize="7.5"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextDisabledBrush}" />
                </Grid>

                <ListBox x:Name="NavList"
                         Grid.Row="1"
                         Margin="0,9,0,0"
                         Style="{StaticResource NavListBoxStyle}"
                         ItemTemplate="{StaticResource NavItemTemplate}"
                         SelectionChanged="NavList_OnSelectionChanged" />

                <TextBlock Grid.Row="2"
                           Text="资 源"
                           Style="{StaticResource EyebrowTextStyle}"
                           Margin="10,18,0,7" />

                <StackPanel Grid.Row="3">
                    <Button Style="{StaticResource SidebarLinkButtonStyle}" Click="DocsButton_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="{DynamicResource IconFont}"
                                       FontSize="12" Width="22" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="使用文档" FontSize="11.5" VerticalAlignment="Center" />
                            <TextBlock Text=".md" Margin="6,0,0,0" FontSize="8"
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarLinkButtonStyle}" Click="ChangelogButton_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="{DynamicResource IconFont}"
                                       FontSize="12" Width="22" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="更新日志" FontSize="11.5" VerticalAlignment="Center" />
                            <Border Margin="6,0,0,0" CornerRadius="4" Padding="4,1"
                                    Background="{DynamicResource InsetSurfaceBrush}">
                                <TextBlock Text="1.0" FontSize="7.5"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarLinkButtonStyle}" Click="GithubButton_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="{DynamicResource IconFont}"
                                       FontSize="12" Width="22" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="GitHub" FontSize="11.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="5" Margin="0,8,0,10">
                    <local:GlassCard CornerRadius="12" Padding="11,10">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Margin="0,0,7,0"
                                             VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="{x:Type Ellipse}">
                                                <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBackdropActive}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="窗口材质"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Backdrop}"
                                           HorizontalAlignment="Right"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}" />
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <TextBlock Text="{Binding BackdropDetail}"
                                           FontSize="9"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock HorizontalAlignment="Right"
                                           FontFamily="{DynamicResource MonoFont}"
                                           FontSize="9"
                                           Foreground="{DynamicResource TextTertiaryBrush}">
                                    <Run Text="{Binding FpsText, Mode=OneWay}" />
                                    <Run Text=" FPS" />
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </local:GlassCard>
                </StackPanel>

                <Grid Grid.Row="6" Margin="2,2,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="16"
                            Background="{DynamicResource AvatarGradientBrush}"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="茶" FontSize="12" FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
                        <TextBlock Text="茶总" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="本地预览 · Win 11"
                                   FontSize="8.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Style="{StaticResource IconButtonStyle}"
                            Width="26" Height="26"
                            FontSize="10.5"
                            Content="&#xE713;"
                            ToolTip="打开设置"
                            Click="SettingsButton_OnClick" />
                </Grid>
            </Grid>
        </Border>

        <!-- ================= Page host ================= -->
        <Grid Grid.Column="1" ClipToBounds="True">
            <Grid x:Name="AmbientLayer" IsHitTestVisible="False">
                <Ellipse Width="560" Height="560" HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-290,-190,0" Fill="{DynamicResource AmbientBlueBrush}" />
                <Ellipse Width="420" Height="420" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-130,-240" Fill="{DynamicResource AmbientVioletBrush}" />
                <Ellipse Width="360" Height="360" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-170,-210,0,0" Fill="{DynamicResource AmbientTealBrush}" />
            </Grid>

            <ContentControl x:Name="PageHost"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />

            <Border x:Name="ToastHost"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,26,24"
                    Padding="13,10"
                    CornerRadius="11"
                    Background="{DynamicResource ToastBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    Opacity="0"
                    IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastTransform" Y="12" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270"
                                      Color="#A0000000" Opacity="0.4" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Border Width="24" Height="24" CornerRadius="7"
                            Background="{DynamicResource AccentSoftBrush}"
                            Margin="0,0,9,0">
                        <TextBlock x:Name="ToastGlyph" Text="&#xE73E;"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="10"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="ToastText"
                               Text="已就绪"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</local:FrostWindow>
