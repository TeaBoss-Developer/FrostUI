<Window x:Class="FrostUI.Demo.ShowcaseBackdropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="#05070D">
    <Grid ClipToBounds="True">
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF071426" Offset="0" />
                    <GradientStop Color="#FF101A36" Offset="0.38" />
                    <GradientStop Color="#FF1A0E2A" Offset="0.72" />
                    <GradientStop Color="#FF060811" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Canvas>
            <Ellipse Canvas.Left="-240" Canvas.Top="-260" Width="780" Height="780" Opacity="0.9">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.45,0.42" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#E62A6BFF" Offset="0" />
                        <GradientStop Color="#80184FCE" Offset="0.5" />
                        <GradientStop Color="#00184FCE" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Canvas.Left="1050" Canvas.Top="-180" Width="920" Height="920" Opacity="0.95">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.55,0.4" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#E64F8BFF" Offset="0" />
                        <GradientStop Color="#8C3366FF" Offset="0.48" />
                        <GradientStop Color="#003366FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Canvas.Left="1120" Canvas.Top="520" Width="760" Height="760" Opacity="0.92">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.45,0.45" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#DDBB5CFF" Offset="0" />
                        <GradientStop Color="#7A7B2DFF" Offset="0.52" />
                        <GradientStop Color="#007B2DFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Canvas.Left="30" Canvas.Top="590" Width="680" Height="680" Opacity="0.8">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#B31FD6B3" Offset="0" />
                        <GradientStop Color="#55148C7A" Offset="0.54" />
                        <GradientStop Color="#00148C7A" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Canvas.Left="520" Canvas.Top="610" Width="420" Height="420" Opacity="0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#99FF7B6B" Offset="0" />
                        <GradientStop Color="#33FF7B6B" Offset="0.58" />
                        <GradientStop Color="#00FF7B6B" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <TextBlock Canvas.Left="320" Canvas.Top="265"
                       Text="FROSTED"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="250"
                       FontWeight="Light"
                       Foreground="#08FFFFFF" />
            <TextBlock Canvas.Left="700" Canvas.Top="690"
                       Text="GLASS / 01"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="72"
                       Foreground="#0CFFFFFF" />

            <Border Canvas.Left="940" Canvas.Top="345"
                    Width="320" Height="210"
                    CornerRadius="24"
                    BorderBrush="#18FFFFFF"
                    BorderThickness="1"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <RotateTransform Angle="-12" />
                </Border.RenderTransform>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#22FFFFFF" Offset="0" />
                        <GradientStop Color="#08FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Canvas>
    </Grid>
</Window>
