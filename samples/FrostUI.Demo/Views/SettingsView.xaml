<UserControl x:Class="FrostUI.Demo.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FrostUI.Controls;assembly=FrostUI"
             Background="Transparent"
             FontFamily="{DynamicResource UiFont}">

    <UserControl.Resources>
        <Style x:Key="KeycapStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource InsetSurfaceStrongBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style x:Key="EnvValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
            <Setter Property="FontSize" Value="8.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="EnvLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Margin="28,20,28,22">

            <!-- Header -->
            <Grid Margin="2,0,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="S E T T I N G S   ·   SYSTEM"
                               Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="让框架更适合你的机器。"
                               Style="{StaticResource PageTitleTextStyle}"
                               FontSize="28"
                               Margin="0,6,0,0" />
                    <TextBlock Text="运行环境、快捷键与诊断信息都集中在这里。"
                               Style="{StaticResource BodyTextStyle}"
                               FontSize="12"
                               Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="30" Padding="11,0" MinWidth="0"
                        VerticalAlignment="Bottom" Margin="0,0,0,4"
                        Click="CopyDiagnostics_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFont}"
                                   FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="复制诊断信息" FontSize="10.5" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Environment + diagnostics -->
            <Grid Height="286" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <controls:GlassCard Grid.Column="0" Margin="0,0,7,0"
                                    CornerRadius="18" Padding="20,16"
                                    VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="8"
                                        Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="&#xE770;" FontFamily="{DynamicResource IconFont}"
                                               FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="运行环境" Style="{StaticResource CardTitleTextStyle}" FontSize="13" />
                                    <TextBlock Text="当前进程与本机能力"
                                               FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                    CornerRadius="5" Padding="6,2"
                                    Background="{DynamicResource SuccessSoftBrush}">
                                <TextBlock Text="COMPATIBLE" FontSize="6.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock Text="操作系统" Style="{StaticResource EnvLabelStyle}" />
                                    <TextBlock x:Name="OsText" Text="Windows 11 · 10.0.26200"
                                               Style="{StaticResource EnvValueStyle}" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock Text=".NET 运行时" Style="{StaticResource EnvLabelStyle}" />
                                    <TextBlock x:Name="RuntimeText" Text=".NET 9.0"
                                               Style="{StaticResource EnvValueStyle}" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock Text="WPF 呈现" Style="{StaticResource EnvLabelStyle}" />
                                    <TextBlock x:Name="WpfText" Text="9.0 · Tier 2"
                                               Style="{StaticResource EnvValueStyle}" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="3" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock Text="显示缩放" Style="{StaticResource EnvLabelStyle}" />
                                    <TextBlock x:Name="DisplayText" Text="150% · 2560 × 1600"
                                               Style="{StaticResource EnvValueStyle}" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="4" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock Text="DWM 合成" Style="{StaticResource EnvLabelStyle}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Ellipse Width="4" Height="4" Margin="0,0,5,0"
                                                 Fill="{DynamicResource SuccessBrush}" />
                                        <TextBlock x:Name="DwmText" Text="正常 · 实时材质"
                                                   Style="{StaticResource EnvValueStyle}"
                                                   HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="5">
                                <TextBlock Text="当前材质" Style="{StaticResource EnvLabelStyle}" />
                                <TextBlock Text="{Binding Backdrop}" Style="{StaticResource EnvValueStyle}"
                                           Foreground="{DynamicResource SuccessBrush}" />
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="2">
                            <TextBlock Text="检测到的能力会自动选择最合适的回退路径"
                                       FontSize="7.5"
                                       Foreground="{DynamicResource TextDisabledBrush}" />
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Height="26" MinWidth="0" Padding="7,0"
                                    HorizontalAlignment="Right"
                                    Click="RefreshMaterial_OnClick">
                                <TextBlock Text="重新检测  &#xE72C;" FontSize="8.5" />
                            </Button>
                        </Grid>
                    </Grid>
                </controls:GlassCard>

                <controls:GlassCard Grid.Column="1" Margin="7,0,0,0"
                                    CornerRadius="18" Padding="20,16"
                                    VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="8"
                                    Background="{DynamicResource SuccessSoftBrush}">
                                <TextBlock Text="&#xE9D9;" FontFamily="{DynamicResource IconFont}"
                                           FontSize="11" Foreground="{DynamicResource SuccessBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="实时诊断" Style="{StaticResource CardTitleTextStyle}" FontSize="13" />
                                <TextBlock Text="CompositionTarget · 当前进程"
                                           FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,10,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="帧率" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FpsText}" FontFamily="{DynamicResource DisplayFont}"
                                               FontSize="30" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text=" FPS" FontSize="9" VerticalAlignment="Bottom"
                                               Margin="0,0,0,6"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding FrameTimeText}" FontFamily="{DynamicResource MonoFont}"
                                           FontSize="8" Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="工作集" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding MemoryText}" FontFamily="{DynamicResource DisplayFont}"
                                               FontSize="30" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text=" MB" FontSize="9" VerticalAlignment="Bottom"
                                               Margin="0,0,0,6"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="进程私有 · 实时采样" FontFamily="{DynamicResource MonoFont}"
                                           FontSize="8" Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2">
                            <TextBlock Text="诊断数据每 800ms 刷新一次"
                                       FontSize="7.5"
                                       Foreground="{DynamicResource TextDisabledBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="4" Height="4" Fill="{DynamicResource SuccessBrush}"
                                         Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="LIVE"
                                           FontFamily="{DynamicResource MonoFont}"
                                           FontSize="7"
                                           Foreground="{DynamicResource SuccessBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </controls:GlassCard>
            </Grid>

            <!-- Shortcuts + about -->
            <Grid Height="222" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <controls:GlassCard Grid.Column="0" Margin="0,0,7,0"
                                    CornerRadius="18" Padding="20,16"
                                    VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="8"
                                    Background="{DynamicResource InsetSurfaceStrongBrush}">
                                <TextBlock Text="&#xE765;" FontFamily="{DynamicResource IconFont}"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="快捷键" Style="{StaticResource CardTitleTextStyle}" FontSize="13" />
                                <TextBlock Text="键盘优先的交互"
                                           FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Grid Height="30">
                                    <TextBlock Text="全局搜索" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border Style="{StaticResource KeycapStyle}"><TextBlock Text="Ctrl" FontSize="7.5" /></Border>
                                        <Border Style="{StaticResource KeycapStyle}" Margin="0"><TextBlock Text="K" FontSize="7.5" /></Border>
                                    </StackPanel>
                                </Grid>
                                <Grid Height="30">
                                    <TextBlock Text="切换主题" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border Style="{StaticResource KeycapStyle}"><TextBlock Text="Ctrl" FontSize="7.5" /></Border>
                                        <Border Style="{StaticResource KeycapStyle}"><TextBlock Text="Shift" FontSize="7.5" /></Border>
                                        <Border Style="{StaticResource KeycapStyle}" Margin="0"><TextBlock Text="T" FontSize="7.5" /></Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                <Grid Height="30">
                                    <TextBlock Text="取消输入" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Border Style="{StaticResource KeycapStyle}" HorizontalAlignment="Right">
                                        <TextBlock Text="Esc" FontSize="7.5" />
                                    </Border>
                                </Grid>
                                <Grid Height="30">
                                    <TextBlock Text="关闭窗口" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Border Style="{StaticResource KeycapStyle}" HorizontalAlignment="Right">
                                        <TextBlock Text="Alt + F4" FontSize="7.5" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </controls:GlassCard>

                <controls:GlassCard Grid.Column="1" Margin="7,0,0,0"
                                    CornerRadius="18" Padding="20,16"
                                    VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Width="34" Height="34"
                                            ContentTemplate="{DynamicResource FrostLogoMarkTemplate}" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="FrostUI" FontFamily="{DynamicResource DisplayFont}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Border CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                            Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock Text="v1.0.0" FontSize="7"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="WPF frosted-glass UI kit"
                                           FontFamily="{DynamicResource MonoFont}"
                                           FontSize="7.5"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="真实亚克力、双主题、12 个控件与零第三方依赖。以 MIT 方式自由使用。"
                                   Style="{StaticResource BodyTextStyle}"
                                   FontSize="10.5"
                                   Margin="0,12,0,0" />

                        <Grid Grid.Row="2">
                            <TextBlock Text=".NET 9 · Windows 10/11"
                                       FontFamily="{DynamicResource MonoFont}"
                                       FontSize="7.5"
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       VerticalAlignment="Center" />
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Height="28" MinWidth="0" Padding="10,0"
                                    HorizontalAlignment="Right"
                                    Click="BrowseComponents_OnClick">
                                <TextBlock Text="浏览控件" FontSize="9.5" FontWeight="SemiBold" />
                            </Button>
                        </Grid>
                    </Grid>
                </controls:GlassCard>
            </Grid>

            <Grid Margin="2,15,2,0">
                <Border Height="1" VerticalAlignment="Top"
                        Background="{DynamicResource DividerBrush}" />
                <TextBlock Text="FROSTUI / SETTINGS"
                           Margin="0,9,0,0"
                           FontFamily="{DynamicResource MonoFont}" FontSize="7"
                           Foreground="{DynamicResource TextDisabledBrush}" />
                <TextBlock Text="Windows 11 · Build 26200"
                           HorizontalAlignment="Right" Margin="0,9,0,0"
                           FontFamily="{DynamicResource MonoFont}" FontSize="7"
                           Foreground="{DynamicResource TextDisabledBrush}" />
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
