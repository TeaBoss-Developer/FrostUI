<UserControl x:Class="FrostUI.Demo.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FrostUI.Controls;assembly=FrostUI"
             Background="Transparent"
             FontFamily="{DynamicResource UiFont}">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="SparkFillBlue" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="#0084AEFF" Offset="0" />
            <GradientStop Color="#5984AEFF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SparkFillTeal" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="#0063E6BE" Offset="0" />
            <GradientStop Color="#4D63E6BE" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Margin="28,20,28,26">

            <!-- ================= Page header ================= -->
            <Grid Margin="2,0,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="DateText" Text="O V E R V I E W   ·   2026.10.26"
                                   Style="{StaticResource EyebrowTextStyle}" />
                        <Border Margin="10,0,0,0" Padding="6,1" CornerRadius="4"
                                Background="{DynamicResource InsetSurfaceBrush}">
                            <TextBlock Text="WINDOWS 11"
                                       FontSize="7"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="GreetingText"
                               Text="晚上好，茶总"
                               Style="{StaticResource PageTitleTextStyle}"
                               FontSize="28"
                               Margin="0,6,0,0" />
                    <TextBlock Text="让每一次交互，都像光穿过玻璃。"
                               Style="{StaticResource BodyTextStyle}"
                               FontSize="12"
                               Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Bottom" Margin="0,0,0,4">
                    <Border Height="30" Padding="11,0" CornerRadius="15"
                            Background="{DynamicResource SuccessSoftBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="5" Height="5" Fill="{DynamicResource SuccessBrush}"
                                     Margin="0,0,7,0" />
                            <TextBlock Text="DWM 合成正常"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource SuccessBrush}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Height="30" MinWidth="0"
                            Padding="11,0"
                            Margin="8,0,0,0"
                            Click="RefreshBackdrop_OnClick"
                            ToolTip="重新查询并应用 DWM 材质">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="10"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="刷新材质" FontSize="10.5" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= Hero ================= -->
            <controls:GlassCard Height="210" Margin="0,16,0,0"
                                CornerRadius="20"
                                Padding="0"
                                Background="{DynamicResource HeroGradientBrush}"
                                HasShadow="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="358" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="27,19,0,18" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="5" Padding="7,3"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource AccentBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="4" Height="4" Fill="{DynamicResource AccentBrush}"
                                             Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="WPF · .NET 9"
                                               FontSize="8.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="5" Padding="7,3" Margin="6,0,0,0"
                                    Background="{DynamicResource InsetSurfaceBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="TRUE ACRYLIC"
                                           FontSize="8" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Margin="0,10,0,0"
                                   Style="{StaticResource HeroTitleTextStyle}"
                                   FontSize="33">
                            <Run Text="把" /><Run Text="光" Foreground="{DynamicResource BrandGradientBrush}" /><Run Text="，留在界面里。" />
                        </TextBlock>

                        <TextBlock Text="FrostUI 把 DWM 亚克力、圆角窗口、玻璃材质与可复用控件一起带进 WPF，让桌面应用拥有真实的光影层次。"
                                   Style="{StaticResource BodyTextStyle}"
                                   Width="490"
                                   HorizontalAlignment="Left"
                                   Margin="0,7,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Height="33"
                                    Click="ExploreButton_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="探索组件" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Text="&#xE72A;"
                                               FontFamily="{DynamicResource IconFont}"
                                               FontSize="9"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Height="33"
                                    Margin="6,0,0,0"
                                    Click="MaterialButton_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;"
                                               FontFamily="{DynamicResource IconFont}"
                                               FontSize="10"
                                               Margin="0,0,7,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="材质说明" FontSize="11.5" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Floating material study -->
                    <Grid Grid.Column="1" ClipToBounds="False">
                        <Canvas Width="340" Height="180"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,4,0">
                            <Ellipse Canvas.Left="76" Canvas.Top="-14"
                                     Width="206" Height="206"
                                     Fill="{DynamicResource OrbBrush}"
                                     Opacity="0.9" />

                            <Border Canvas.Left="28" Canvas.Top="43"
                                    Width="206" Height="116"
                                    CornerRadius="15"
                                    Background="{DynamicResource InsetSurfaceBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    Opacity="0.65"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform Angle="-9" />
                                        <TranslateTransform X="-2" Y="4" />
                                    </TransformGroup>
                                </Border.RenderTransform>
                            </Border>

                            <Border Canvas.Left="68" Canvas.Top="24"
                                    Width="222" Height="132"
                                    CornerRadius="17"
                                    BorderBrush="#4DFFFFFF"
                                    BorderThickness="1"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3DFFFFFF" Offset="0" />
                                        <GradientStop Color="#17FFFFFF" Offset="0.52" />
                                        <GradientStop Color="#26A9C6FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28" ShadowDepth="12" Direction="270"
                                                      Color="#B0000000" Opacity="0.45" />
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform Angle="6" />
                                    </TransformGroup>
                                </Border.RenderTransform>

                                <Grid Margin="16,12,16,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="4.5" Height="4.5" Fill="#FFFF8C9A" Margin="0,0,4,0" />
                                        <Ellipse Width="4.5" Height="4.5" Fill="#FFFFD479" Margin="0,0,4,0" />
                                        <Ellipse Width="4.5" Height="4.5" Fill="#FF74E4C4" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                        <TextBlock Text="F R O S T"
                                                   FontFamily="{DynamicResource DisplayFont}"
                                                   FontSize="23"
                                                   FontWeight="Light"
                                                   Foreground="White"
                                                   Opacity="0.95" />
                                        <TextBlock Text="MATERIAL / ACRYLIC · 01"
                                                   FontFamily="{DynamicResource MonoFont}"
                                                   FontSize="7.5"
                                                   Foreground="#B3FFFFFF"
                                                   Margin="1,2,0,0" />
                                        <StackPanel Margin="1,11,0,0">
                                            <Border Height="3" Width="130" CornerRadius="1.5"
                                                    Background="#66FFFFFF" HorizontalAlignment="Left" />
                                            <Border Height="3" Width="96" CornerRadius="1.5"
                                                    Background="#33FFFFFF" HorizontalAlignment="Left"
                                                    Margin="0,5,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid Grid.Row="2">
                                        <TextBlock Text="DWM COMPOSITED"
                                                   FontFamily="{DynamicResource MonoFont}"
                                                   FontSize="7"
                                                   Foreground="#8CFFFFFF" />
                                        <TextBlock Text="60 FPS"
                                                   HorizontalAlignment="Right"
                                                   FontFamily="{DynamicResource MonoFont}"
                                                   FontSize="7"
                                                   Foreground="#8CFFFFFF" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Canvas.Left="12" Canvas.Top="137"
                                    CornerRadius="7"
                                    Padding="8,4"
                                    Background="{DynamicResource ToastBrush}"
                                    BorderBrush="#33FFFFFF"
                                    BorderThickness="1"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="-4" />
                                </Border.RenderTransform>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;"
                                               FontFamily="{DynamicResource IconFont}"
                                               FontSize="8"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,0,5,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="BLUR 30 PX"
                                               FontFamily="{DynamicResource MonoFont}"
                                               FontSize="7.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Canvas.Left="243" Canvas.Top="15"
                                    CornerRadius="7"
                                    Padding="8,4"
                                    Background="{DynamicResource ToastBrush}"
                                    BorderBrush="#33FFFFFF"
                                    BorderThickness="1"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="7" />
                                </Border.RenderTransform>
                                <TextBlock Text="NOISE 2.6%"
                                           FontFamily="{DynamicResource MonoFont}"
                                           FontSize="7.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </Canvas>
                    </Grid>
                </Grid>
            </controls:GlassCard>

            <!-- ================= Stats ================= -->
            <Grid Height="110" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:GlassCard Grid.Column="0" Margin="0,0,6,0"
                                    CornerRadius="16" Padding="16,14"
                                    IsInteractive="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10"
                                Background="{DynamicResource AccentSoftBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE790;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="13"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="窗口材质" Style="{StaticResource CaptionTextStyle}" FontSize="10" />
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <TextBlock Text="{Binding Backdrop}" Style="{StaticResource MetricValueTextStyle}" FontSize="19" />
                                <TextBlock Text="  实时" FontSize="9"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Bottom" Margin="0,0,0,3" />
                            </StackPanel>
                            <TextBlock Text="{Binding BackdropDetail}" FontSize="9"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="2" CornerRadius="5" Padding="6,2"
                                Background="{DynamicResource SuccessSoftBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="LIVE" FontSize="7" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}" />
                        </Border>
                    </Grid>
                </controls:GlassCard>

                <controls:GlassCard Grid.Column="1" Margin="6,0,6,0"
                                    CornerRadius="16" Padding="16,14"
                                    IsInteractive="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10"
                                Background="{DynamicResource InfoSoftBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE9D9;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="13"
                                       Foreground="{DynamicResource InfoBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="合成帧率" Style="{StaticResource CaptionTextStyle}" FontSize="10" />
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <TextBlock Text="{Binding FpsText}" Style="{StaticResource MetricValueTextStyle}" FontSize="19" />
                                <TextBlock Text=" FPS" FontSize="9"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Bottom" Margin="0,0,0,3" />
                            </StackPanel>
                            <TextBlock Text="{Binding FrameTimeText}" FontSize="9"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                        <controls:Sparkline Grid.Column="2" Width="78" Height="38"
                                            VerticalAlignment="Center"
                                            Values="42,38,46,41,54,48,58,53,64,60,68,63"
                                            Stroke="{DynamicResource AccentBrush}"
                                            Fill="{StaticResource SparkFillBlue}"
                                            StrokeThickness="1.5" />
                    </Grid>
                </controls:GlassCard>

                <controls:GlassCard Grid.Column="2" Margin="6,0,0,0"
                                    CornerRadius="16" Padding="16,14"
                                    IsInteractive="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10"
                                Background="{DynamicResource SuccessSoftBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE950;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="13"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="工作集内存" Style="{StaticResource CaptionTextStyle}" FontSize="10" />
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <TextBlock Text="{Binding MemoryText}" Style="{StaticResource MetricValueTextStyle}" FontSize="19" />
                                <TextBlock Text=" MB" FontSize="9"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Bottom" Margin="0,0,0,3" />
                            </StackPanel>
                            <TextBlock Text="本次会话 · 进程私有" FontSize="9"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                        <controls:Sparkline Grid.Column="2" Width="78" Height="38"
                                            VerticalAlignment="Center"
                                            Values="34,32,36,35,31,37,39,36,40,38,42,39"
                                            Stroke="{DynamicResource SuccessBrush}"
                                            Fill="{StaticResource SparkFillTeal}"
                                            StrokeThickness="1.5" />
                    </Grid>
                </controls:GlassCard>
            </Grid>

            <!-- ================= Interaction + appearance ================= -->
            <Grid Height="258" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <controls:GlassCard Grid.Column="0" Margin="0,0,7,0"
                                    CornerRadius="18" Padding="20,16"
                                    VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="8"
                                        Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="&#xE945;"
                                               FontFamily="{DynamicResource IconFont}"
                                               FontSize="11"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="交互实验室" Style="{StaticResource CardTitleTextStyle}" FontSize="13" />
                                    <TextBlock Text="这些控件会真正改变窗口材质" FontSize="9"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="LIVE PREVIEW"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource MonoFont}"
                                       FontSize="7.5"
                                       Foreground="{DynamicResource TextDisabledBrush}" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.85*" />
                                <ColumnDefinition Width="1.15*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Grid Height="30">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="系统材质"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <controls:GlassToggleSwitch x:Name="BlurToggle"
                                                                HorizontalAlignment="Right"
                                                                IsChecked="True"
                                                                Checked="BlurToggle_OnChanged"
                                                                Unchecked="BlurToggle_OnChanged" />
                                </Grid>
                                <Grid Height="30" Margin="0,7,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="动态光斑"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <controls:GlassToggleSwitch x:Name="AmbientToggle"
                                                                HorizontalAlignment="Right"
                                                                IsChecked="True"
                                                                Checked="AmbientToggle_OnChanged"
                                                                Unchecked="AmbientToggle_OnChanged" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                <Grid>
                                    <TextBlock Text="玻璃浓度"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock x:Name="TintValueText" Text="28%"
                                               HorizontalAlignment="Right"
                                               FontFamily="{DynamicResource MonoFont}"
                                               FontSize="9.5"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Grid>
                                <Slider x:Name="TintSlider"
                                        Style="{StaticResource GlassSliderStyle}"
                                        Minimum="0" Maximum="60" Value="28"
                                        Margin="0,3,0,0"
                                        ToolTip="Acrylic 的 tint 浓度；Mica 的颜色由系统控制"
                                        ValueChanged="TintSlider_OnValueChanged" />
                                <Grid Margin="0,7,0,0">
                                    <TextBlock Text="合成质量"
                                               FontSize="9"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="92%"
                                               HorizontalAlignment="Right"
                                               FontFamily="{DynamicResource MonoFont}"
                                               FontSize="8.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </Grid>
                                <ProgressBar Style="{StaticResource GlassProgressBarStyle}"
                                             Value="92" Height="5" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="3" Margin="0,0,0,0"
                                Background="{DynamicResource InsetSurfaceBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="11,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="BACKDROP"
                                               FontFamily="{DynamicResource MonoFont}"
                                               FontSize="7"
                                               Foreground="{DynamicResource TextDisabledBrush}" />
                                    <TextBlock Text="{Binding Backdrop}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="TINT"
                                               FontFamily="{DynamicResource MonoFont}"
                                               FontSize="7"
                                               Foreground="{DynamicResource TextDisabledBrush}" />
                                    <TextBlock Text="{Binding Text, ElementName=TintValueText}"
                                               FontFamily="{DynamicResource MonoFont}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="NOISE"
                                               FontFamily="{DynamicResource MonoFont}"
                                               FontSize="7"
                                               Foreground="{DynamicResource TextDisabledBrush}" />
                                    <TextBlock Text="2.6%"
                                               FontFamily="{DynamicResource MonoFont}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="4" Margin="0,9,0,0">
                            <TextBlock Text="DWM 合成策略 · 仅 Windows 11"
                                       FontFamily="{DynamicResource MonoFont}"
                                       FontSize="7.5"
                                       Foreground="{DynamicResource TextDisabledBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="4" Height="4" Fill="{DynamicResource SuccessBrush}"
                                         Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="实时写入"
                                           FontSize="8"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </controls:GlassCard>

                <controls:GlassCard Grid.Column="1" Margin="7,0,0,0"
                                    CornerRadius="18" Padding="20,16"
                                    VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="8"
                                        Background="{DynamicResource InsetSurfaceStrongBrush}">
                                    <TextBlock Text="&#xE771;"
                                               FontFamily="{DynamicResource IconFont}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="外观" Style="{StaticResource CardTitleTextStyle}" FontSize="13" />
                                    <TextBlock Text="主题、强调色与窗口材质" FontSize="9"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <TextBlock Text="强调色" FontSize="9.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <RadioButton x:Name="AccentBlue" GroupName="Accent"
                                             Style="{StaticResource AccentSwatchStyle}"
                                             Background="#84AEFF" Tag="#84AEFF"
                                             IsChecked="True"
                                             Checked="AccentSwatch_OnChecked" />
                                <RadioButton x:Name="AccentMint" GroupName="Accent"
                                             Style="{StaticResource AccentSwatchStyle}"
                                             Background="#63E6BE" Tag="#63E6BE"
                                             Checked="AccentSwatch_OnChecked" />
                                <RadioButton x:Name="AccentViolet" GroupName="Accent"
                                             Style="{StaticResource AccentSwatchStyle}"
                                             Background="#B79CFF" Tag="#B79CFF"
                                             Checked="AccentSwatch_OnChecked" />
                                <RadioButton x:Name="AccentPink" GroupName="Accent"
                                             Style="{StaticResource AccentSwatchStyle}"
                                             Background="#FF9BC7" Tag="#FF9BC7"
                                             Checked="AccentSwatch_OnChecked" />
                                <RadioButton x:Name="AccentAmber" GroupName="Accent"
                                             Style="{StaticResource AccentSwatchStyle}"
                                             Background="#FFC46B" Tag="#FFC46B"
                                             Margin="0"
                                             Checked="AccentSwatch_OnChecked" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" Height="1" Margin="0,11,0,0"
                                Background="{DynamicResource DividerBrush}" />

                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE706;"
                                           FontFamily="{DynamicResource IconFont}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="深色模式" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <controls:GlassToggleSwitch x:Name="ThemeToggle"
                                                        HorizontalAlignment="Right"
                                                        IsChecked="True"
                                                        Checked="ThemeToggle_OnChanged"
                                                        Unchecked="ThemeToggle_OnChanged" />
                        </Grid>

                        <StackPanel Grid.Row="4" Margin="0,11,0,0">
                            <TextBlock Text="窗口材质" FontSize="9.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <RadioButton x:Name="MaterialAcrylic" Content="Acrylic" GroupName="Material"
                                             Style="{StaticResource GlassRadioButtonStyle}"
                                             Tag="Acrylic" IsChecked="True"
                                             Checked="MaterialRadio_OnChecked" />
                                <RadioButton x:Name="MaterialMica" Content="Mica" GroupName="Material"
                                             Style="{StaticResource GlassRadioButtonStyle}"
                                             Tag="Mica"
                                             Checked="MaterialRadio_OnChecked" />
                                <RadioButton x:Name="MaterialNone" Content="关闭" GroupName="Material"
                                             Style="{StaticResource GlassRadioButtonStyle}"
                                             Tag="None"
                                             Checked="MaterialRadio_OnChecked" />
                            </StackPanel>
                            <TextBlock Text="材质的支持情况会自动检查并回退"
                                       FontSize="8"
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       Margin="1,7,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="5" VerticalAlignment="Bottom" Margin="0,9,0,0">
                            <Border Height="1" VerticalAlignment="Top"
                                    Background="{DynamicResource DividerBrush}" />
                            <TextBlock Text="FROSTUI / MATERIAL ENGINE"
                                       Margin="0,8,0,0"
                                       FontFamily="{DynamicResource MonoFont}"
                                       FontSize="7"
                                       Foreground="{DynamicResource TextDisabledBrush}" />
                            <TextBlock Text="v1.0"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Right"
                                       FontFamily="{DynamicResource MonoFont}"
                                       FontSize="7"
                                       Foreground="{DynamicResource TextDisabledBrush}" />
                        </Grid>
                    </Grid>
                </controls:GlassCard>
            </Grid>

            <Grid Margin="2,16,2,0">
                <Border Height="1" VerticalAlignment="Top"
                        Background="{DynamicResource DividerBrush}" Opacity="0.7" />
                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                    <TextBlock Text="FROSTUI / GLASS SYSTEM"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="7.5"
                               Foreground="{DynamicResource TextDisabledBrush}" />
                    <TextBlock Text="WPF · DWM"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="7.5"
                               Margin="14,0,0,0"
                               Foreground="{DynamicResource TextDisabledBrush}" />
                </StackPanel>
                <TextBlock Text="v1.0.0 · 2026"
                           HorizontalAlignment="Right"
                           Margin="0,9,0,0"
                           FontFamily="{DynamicResource MonoFont}"
                           FontSize="7.5"
                           Foreground="{DynamicResource TextDisabledBrush}" />
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
