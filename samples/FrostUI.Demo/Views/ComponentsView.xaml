<UserControl x:Class="FrostUI.Demo.Views.ComponentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FrostUI.Controls;assembly=FrostUI"
             Background="Transparent"
             FontFamily="{DynamicResource UiFont}">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="ComponentSparkFill" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="#0084AEFF" Offset="0" />
            <GradientStop Color="#6684AEFF" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="DemoLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="FontSize" Value="9.5" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Margin="28,20,28,22">

            <!-- Header -->
            <Grid Margin="2,0,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="C O M P O N E N T S   ·   K I T"
                                   Style="{StaticResource EyebrowTextStyle}" />
                        <Border Margin="10,0,0,0" Padding="6,1" CornerRadius="4"
                                Background="{DynamicResource InsetSurfaceBrush}">
                            <TextBlock Text="12 COMPONENTS" FontSize="7" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="控件，也可以有呼吸感。"
                               Style="{StaticResource PageTitleTextStyle}"
                               FontSize="28"
                               Margin="0,6,0,0" />
                    <TextBlock Text="同一套玻璃材质下的按钮、输入、选择与数据可视化。"
                               Style="{StaticResource BodyTextStyle}"
                               FontSize="12"
                               Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Bottom" Margin="0,0,0,4">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Height="30" Padding="11,0" MinWidth="0"
                            Click="CopySample_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFont}"
                                       FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="复制示例" FontSize="10.5" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Height="30" Padding="12,0" MinWidth="0"
                            Margin="8,0,0,0"
                            Click="OpenAppearance_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="外观设置" FontSize="10.5" FontWeight="SemiBold" />
                            <TextBlock Text="&#xE72A;" FontFamily="{DynamicResource IconFont}"
                                       FontSize="9" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Component grid -->
            <Grid Height="514" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="250" />
                    <RowDefinition Height="250" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Buttons -->
                <controls:GlassCard Grid.Row="0" Grid.Column="0" Margin="0,0,7,7"
                                    CornerRadius="18" Padding="20,16"
                                    VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="8"
                                        Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="&#xE8A9;" FontFamily="{DynamicResource IconFont}"
                                               FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="按钮" Style="{StaticResource CardTitleTextStyle}" FontSize="13" />
                                    <TextBlock Text="4 种层级 · 图标按钮 · 状态反馈"
                                               FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="BUTTONS" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource MonoFont}" FontSize="7.5"
                                       Foreground="{DynamicResource TextDisabledBrush}" />
                        </Grid>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButtonStyle}" Height="32"
                                        MinWidth="0" Padding="13,0"
                                        Tag="Primary"
                                        Click="DemoAction_OnClick">
                                    <TextBlock Text="主要行动" FontSize="11" />
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Height="32"
                                        MinWidth="0" Padding="13,0" Margin="7,0,0,0"
                                        Tag="Secondary"
                                        Click="DemoAction_OnClick">
                                    <TextBlock Text="次要操作" FontSize="11" />
                                </Button>
                                <Button Style="{StaticResource GhostButtonStyle}" Height="32"
                                        MinWidth="0" Padding="13,0" Margin="3,0,0,0"
                                        Tag="Ghost"
                                        Click="DemoAction_OnClick">
                                    <TextBlock Text="Ghost" FontSize="11" />
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource DangerButtonStyle}" Height="30"
                                        MinWidth="0" Padding="11,0"
                                        Tag="Danger"
                                        Click="DemoAction_OnClick">
                                    <TextBlock Text="危险操作" FontSize="10.5" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                                        Margin="8,0,0,0" Content="&#xE710;"
                                        ToolTip="添加" Tag="Icon"
                                        Click="DemoAction_OnClick" />
                                <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                                        Content="&#xE721;" ToolTip="搜索" Tag="Icon"
                                        Click="DemoAction_OnClick" />
                                <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                                        Content="&#xE712;" ToolTip="更多" Tag="Icon"
                                        Click="DemoAction_OnClick" />
                                <Button Style="{StaticResource GhostButtonStyle}" Height="30"
                                        MinWidth="0" Padding="9,0" Margin="4,0,0,0"
                                        Tag="Link" Click="DemoAction_OnClick">
                                    <TextBlock Text="文本按钮  →" FontSize="10.5" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Row="2" Padding="9,6" CornerRadius="7"
                                Background="{DynamicResource InsetSurfaceBrush}">
                            <TextBlock Text="Button · Primary / Secondary / Ghost / Danger"
                                       FontFamily="{DynamicResource MonoFont}"
                                       FontSize="7.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Border>
                    </Grid>
                </controls:GlassCard>

                <!-- Selection -->
                <controls:GlassCard Grid.Row="0" Grid.Column="1" Margin="7,0,0,7"
                                    CornerRadius="18" Padding="20,16"
                                    VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="8"
                                        Background="{DynamicResource SuccessSoftBrush}">
                                    <TextBlock Text="&#xE7F4;" FontFamily="{DynamicResource IconFont}"
                                               FontSize="11" Foreground="{DynamicResource SuccessBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="选择" Style="{StaticResource CardTitleTextStyle}" FontSize="13" />
                                    <TextBlock Text="开关 · 分段选择 · 状态"
                                               FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="SELECTION" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource MonoFont}" FontSize="7.5"
                                       Foreground="{DynamicResource TextDisabledBrush}" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Grid Height="27">
                                    <TextBlock Text="实时模糊" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <controls:GlassToggleSwitch HorizontalAlignment="Right" IsChecked="True" />
                                </Grid>
                                <Grid Height="27" Margin="0,3,0,0">
                                    <TextBlock Text="动态光斑" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <controls:GlassToggleSwitch HorizontalAlignment="Right" IsChecked="True" />
                                </Grid>
                                <Grid Height="27" Margin="0,3,0,0">
                                    <TextBlock Text="减少动效" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextDisabledBrush}" />
                                    <controls:GlassToggleSwitch HorizontalAlignment="Right" IsEnabled="False" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="16,5,0,0">
                                <TextBlock Text="密度" FontSize="9"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <RadioButton Content="紧凑" GroupName="Density"
                                                 Style="{StaticResource GlassRadioButtonStyle}"
                                                 FontSize="9.5" Padding="8,0" Height="26" />
                                    <RadioButton Content="平衡" GroupName="Density" IsChecked="True"
                                                 Style="{StaticResource GlassRadioButtonStyle}"
                                                 FontSize="9.5" Padding="8,0" Height="26" />
                                    <RadioButton Content="舒适" GroupName="Density"
                                                 Style="{StaticResource GlassRadioButtonStyle}"
                                                 FontSize="9.5" Padding="8,0" Height="26" />
                                </StackPanel>
                                <TextBlock Text="RadioButton · GroupName"
                                           FontFamily="{DynamicResource MonoFont}"
                                           FontSize="7"
                                           Foreground="{DynamicResource TextDisabledBrush}"
                                           Margin="1,8,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" Padding="9,6" CornerRadius="7"
                                Background="{DynamicResource InsetSurfaceBrush}">
                            <TextBlock Text="ToggleSwitch · IsChecked / IsEnabled"
                                       FontFamily="{DynamicResource MonoFont}"
                                       FontSize="7.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Border>
                    </Grid>
                </controls:GlassCard>

                <!-- Inputs -->
                <controls:GlassCard Grid.Row="1" Grid.Column="0" Margin="0,7,7,0"
                                    CornerRadius="18" Padding="20,16"
                                    VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="8"
                                        Background="{DynamicResource WarningSoftBrush}">
                                    <TextBlock Text="&#xE70F;" FontFamily="{DynamicResource IconFont}"
                                               FontSize="11" Foreground="{DynamicResource WarningBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="输入" Style="{StaticResource CardTitleTextStyle}" FontSize="13" />
                                    <TextBlock Text="文本 · 搜索 · 滑块"
                                               FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="INPUTS" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource MonoFont}" FontSize="7.5"
                                       Foreground="{DynamicResource TextDisabledBrush}" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="项目名称" Style="{StaticResource DemoLabelStyle}" />
                                <TextBox Style="{StaticResource GlassTextBoxStyle}"
                                         Height="30" Margin="0,5,0,0" Text="FrostUI" />
                                <TextBlock Text="搜索" Style="{StaticResource DemoLabelStyle}" Margin="0,8,0,0" />
                                <Border Height="30" Margin="0,5,0,0" CornerRadius="9"
                                        Background="{DynamicResource InputBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1">
                                    <Grid Margin="9,0,7,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}"
                                                   FontSize="9.5" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <TextBox Grid.Column="1" Style="{StaticResource SearchTextBoxStyle}"
                                                 Height="28" VerticalAlignment="Center"
                                                 Text="亚克力" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <Grid>
                                    <TextBlock Text="模糊半径" Style="{StaticResource DemoLabelStyle}" />
                                    <TextBlock Text="30 px" HorizontalAlignment="Right"
                                               FontFamily="{DynamicResource MonoFont}" FontSize="8.5"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Grid>
                                <Slider Style="{StaticResource GlassSliderStyle}"
                                        Minimum="0" Maximum="60" Value="30" Margin="0,5,0,0" />
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="预览强度" Style="{StaticResource DemoLabelStyle}" />
                                    <TextBlock Text="68%" HorizontalAlignment="Right"
                                               FontFamily="{DynamicResource MonoFont}" FontSize="8.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </Grid>
                                <ProgressBar Style="{StaticResource GlassProgressBarStyle}"
                                             Value="68" Height="5" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" Padding="9,6" CornerRadius="7"
                                Background="{DynamicResource InsetSurfaceBrush}">
                            <TextBlock Text="TextBox · Slider · ProgressBar"
                                       FontFamily="{DynamicResource MonoFont}"
                                       FontSize="7.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Border>
                    </Grid>
                </controls:GlassCard>

                <!-- Data -->
                <controls:GlassCard Grid.Row="1" Grid.Column="1" Margin="7,7,0,0"
                                    CornerRadius="18" Padding="20,16"
                                    VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="8"
                                        Background="{DynamicResource DangerSoftBrush}">
                                    <TextBlock Text="&#xE9D9;" FontFamily="{DynamicResource IconFont}"
                                               FontSize="11" Foreground="{DynamicResource DangerBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="数据" Style="{StaticResource CardTitleTextStyle}" FontSize="13" />
                                    <TextBlock Text="环形进度 · 趋势 · 指标"
                                               FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="DATA" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource MonoFont}" FontSize="7.5"
                                       Foreground="{DynamicResource TextDisabledBrush}" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="96" Height="96" VerticalAlignment="Center">
                                <controls:ProgressRing Value="78" StrokeThickness="8"
                                                       TrackBrush="{DynamicResource InsetSurfaceStrongBrush}"
                                                       ProgressBrush="{DynamicResource AccentGradientBrush}"
                                                       GlowBrush="{DynamicResource AccentGlowBrush}" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="78%" FontFamily="{DynamicResource DisplayFont}"
                                               FontSize="19" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="完成度" FontSize="8"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="12,5,0,0">
                                <Grid>
                                    <TextBlock Text="渲染帧率" FontSize="9"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="60 FPS" HorizontalAlignment="Right"
                                               FontFamily="{DynamicResource MonoFont}" FontSize="8.5"
                                               Foreground="{DynamicResource SuccessBrush}" />
                                </Grid>
                                <controls:Sparkline Height="55" Margin="0,3,0,0"
                                                    Values="42,48,44,55,50,62,56,66,60,72,68,76"
                                                    Stroke="{DynamicResource AccentBrush}"
                                                    Fill="{StaticResource ComponentSparkFill}"
                                                    StrokeThickness="1.6" />
                                <Grid Margin="0,5,0,0">
                                    <TextBlock Text="玻璃合成质量" FontSize="9"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="92%" HorizontalAlignment="Right"
                                               FontFamily="{DynamicResource MonoFont}" FontSize="8.5"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Grid>
                                <ProgressBar Style="{StaticResource GlassProgressBarStyle}"
                                             Value="92" Height="5" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" Padding="9,6" CornerRadius="7"
                                Background="{DynamicResource InsetSurfaceBrush}">
                            <TextBlock Text="ProgressRing · Sparkline · ProgressBar"
                                       FontFamily="{DynamicResource MonoFont}"
                                       FontSize="7.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Border>
                    </Grid>
                </controls:GlassCard>
            </Grid>

            <!-- Footer strip -->
            <Grid Margin="2,15,2,0">
                <Border Height="1" VerticalAlignment="Top"
                        Background="{DynamicResource DividerBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                    <TextBlock Text="12 COMPONENTS"
                               FontFamily="{DynamicResource MonoFont}" FontSize="7.5"
                               Foreground="{DynamicResource TextDisabledBrush}" />
                    <TextBlock Text="2 THEMES"
                               FontFamily="{DynamicResource MonoFont}" FontSize="7.5"
                               Margin="14,0,0,0"
                               Foreground="{DynamicResource TextDisabledBrush}" />
                    <TextBlock Text="0 DEPENDENCIES"
                               FontFamily="{DynamicResource MonoFont}" FontSize="7.5"
                               Margin="14,0,0,0"
                               Foreground="{DynamicResource TextDisabledBrush}" />
                </StackPanel>
                <TextBlock Text="所有控件均可通过主题资源重新着色"
                           HorizontalAlignment="Right" Margin="0,9,0,0"
                           FontSize="8"
                           Foreground="{DynamicResource TextDisabledBrush}" />
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
