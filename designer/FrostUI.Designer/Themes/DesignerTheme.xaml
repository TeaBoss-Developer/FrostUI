<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:FrostUI.Controls;assembly=FrostUI"
                    xmlns:conv="clr-namespace:FrostUI.Designer.Converters"
                    xmlns:views="clr-namespace:FrostUI.Designer.Views">

    <!-- ============================================================
         Converters and brushes
         ============================================================ -->
    <BooleanToVisibilityConverter x:Key="DesignBoolToVis" />
    <conv:BoolToOpacityConverter x:Key="BoolToOpacity" />
    <conv:BoolToFontWeightConverter x:Key="BoolToFontWeight" />
    <conv:PercentConverter x:Key="PercentConverter" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <conv:StringToFontFamilyConverter x:Key="StringToFontFamily" />
    <conv:PathToImageSourceConverter x:Key="PathToImageSource" />
    <conv:ImageCropBrushConverter x:Key="ImageCropBrush" />
    <conv:StringLinesConverter x:Key="StringLines" />

    <LinearGradientBrush x:Key="DesignerCanvasBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5C080D17" Offset="0" />
        <GradientStop Color="#33070A12" Offset="0.55" />
        <GradientStop Color="#4D0B101B" Offset="1" />
    </LinearGradientBrush>

    <DrawingBrush x:Key="DesignerDotBrush" TileMode="Tile"
                  Viewport="0,0,22,22" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#1CFFFFFF">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="DesignerGridBrush" TileMode="Tile"
                  Viewport="0,0,8,8" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen Brush="#14FFFFFF" Thickness="0.5" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="8,0" />
                        <LineGeometry StartPoint="0,0" EndPoint="0,8" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ============================================================
         Shared panel styles
         ============================================================ -->
    <Style x:Key="InspectorSectionStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource InsetSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="InspectorLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="InspectorSectionTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="InspectorFieldStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource GlassTextBoxStyle}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="CodeEditorTextBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}" />
        <Setter Property="SelectionTextBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionOpacity" Value="0.82" />
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="11,9" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="AcceptsTab" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="SpellCheck.IsEnabled" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="ConsoleTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource CodeEditorTextBoxStyle}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style x:Key="MiniActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="Height" Value="22" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>

    <Style x:Key="ToolTileStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardGradientBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardHoverGradientBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderStrongBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CompletionListItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource NavHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LayerListItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource NavHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LayerListStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource LayerListItemStyle}" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style x:Key="HistoryListItemStyle" TargetType="{x:Type ListBoxItem}"
           BasedOn="{StaticResource LayerListItemStyle}">
        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
    </Style>

    <Style x:Key="HistoryListStyle" TargetType="{x:Type ListBox}"
           BasedOn="{StaticResource LayerListStyle}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource HistoryListItemStyle}" />
    </Style>

    <Style x:Key="DiagnosticsListItemStyle" TargetType="{x:Type ListBoxItem}"
           BasedOn="{StaticResource LayerListItemStyle}">
        <Setter Property="AutomationProperties.Name" Value="{Binding Display}" />
    </Style>

    <Style x:Key="DiagnosticsListStyle" TargetType="{x:Type ListBox}"
           BasedOn="{StaticResource LayerListStyle}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource DiagnosticsListItemStyle}" />
    </Style>

    <Style x:Key="CompletionListStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource CompletionListItemStyle}" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style x:Key="StatusBarTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================
         Toolbox item
         ============================================================ -->
    <DataTemplate x:Key="ToolTileTemplate">
        <Border Style="{StaticResource ToolTileStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="27" Height="27" CornerRadius="7"
                        Background="{DynamicResource AccentSoftBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Icon}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Description}"
                               FontSize="8"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ============================================================
         Design surface controls
         ============================================================ -->
    <DataTemplate x:Key="DesignButtonTemplate">
        <Button Width="{Binding Width}" Height="{Binding Height}"
                Style="{StaticResource PrimaryButtonStyle}"
                Content="{Binding Text}"
                FontFamily="{Binding FontFamily, Converter={StaticResource StringToFontFamily}}"
                FontSize="{Binding FontSize}"
                IsEnabled="{Binding IsEnabled}"
                IsHitTestVisible="False" />
    </DataTemplate>

    <DataTemplate x:Key="DesignLabelTemplate">
        <TextBlock Width="{Binding Width}" Height="{Binding Height}"
                   Text="{Binding Text}"
                   FontFamily="{Binding FontFamily, Converter={StaticResource StringToFontFamily}}"
                   FontSize="{Binding FontSize}"
                   FontWeight="{Binding IsBold, Converter={StaticResource BoolToFontWeight}}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Top" />
    </DataTemplate>

    <DataTemplate x:Key="DesignTextBoxTemplate">
        <TextBox Width="{Binding Width}" Height="{Binding Height}"
                 Style="{StaticResource GlassTextBoxStyle}"
                 Text="{Binding Text, Mode=OneWay}"
                 FontFamily="{Binding FontFamily, Converter={StaticResource StringToFontFamily}}"
                 FontSize="{Binding FontSize}"
                 IsEnabled="{Binding IsEnabled}"
                 IsHitTestVisible="False" />
    </DataTemplate>

    <DataTemplate x:Key="DesignToggleTemplate">
        <controls:GlassToggleSwitch Width="{Binding Width}" Height="{Binding Height}"
                                    IsChecked="{Binding IsOn}"
                                    IsEnabled="{Binding IsEnabled}"
                                    IsHitTestVisible="False"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top" />
    </DataTemplate>

    <DataTemplate x:Key="DesignSliderTemplate">
        <Slider Width="{Binding Width}" Height="{Binding Height}"
                Style="{StaticResource GlassSliderStyle}"
                Minimum="0" Maximum="100"
                Value="{Binding Value, Mode=OneWay}"
                IsEnabled="{Binding IsEnabled}"
                IsHitTestVisible="False" />
    </DataTemplate>

    <DataTemplate x:Key="DesignProgressBarTemplate">
        <ProgressBar Width="{Binding Width}" Height="{Binding Height}"
                     Style="{StaticResource GlassProgressBarStyle}"
                     Value="{Binding Value, Mode=OneWay}"
                     IsHitTestVisible="False" />
    </DataTemplate>

    <DataTemplate x:Key="DesignProgressRingTemplate">
        <Grid Width="{Binding Width}" Height="{Binding Height}">
            <controls:ProgressRing Value="{Binding Value}"
                                   StrokeThickness="8"
                                   TrackBrush="{DynamicResource InsetSurfaceStrongBrush}"
                                   ProgressBrush="{DynamicResource AccentGradientBrush}"
                                   GlowBrush="{DynamicResource AccentGlowBrush}"
                                   IsHitTestVisible="False" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Value, StringFormat={}{0:0}%}"
                           FontFamily="{DynamicResource DisplayFont}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="完成度"
                           FontSize="7.5"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DesignImageTemplate">
        <Border Width="{Binding Width}" Height="{Binding Height}"
                CornerRadius="{Binding CornerRadius}" ClipToBounds="True"
                Background="{DynamicResource InsetSurfaceBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                IsHitTestVisible="False">
            <Grid>
                <TextBlock Text="图片" FontSize="10"
                           Foreground="{DynamicResource TextDisabledBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border>
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource ImageCropBrush}">
                            <Binding Path="ImagePath" />
                            <Binding Path="ImageCrop" />
                            <Binding Path="ImageStretch" />
                        </MultiBinding>
                    </Border.Background>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="DesignListTemplate">
        <Border Width="{Binding Width}" Height="{Binding Height}"
                CornerRadius="{Binding CornerRadius}" ClipToBounds="True"
                Background="{DynamicResource InsetSurfaceBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                IsHitTestVisible="False">
            <ListBox ItemsSource="{Binding ListItems, Converter={StaticResource StringLines}}"
                     Background="Transparent" BorderThickness="0" FontSize="{Binding FontSize}"
                     Padding="8,5">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="DesignContainerTemplate">
        <Border Width="{Binding Width}" Height="{Binding Height}"
                CornerRadius="{Binding CornerRadius}" ClipToBounds="True"
                Background="#18000000" BorderBrush="{DynamicResource AccentBorderBrush}"
                BorderThickness="1.2" IsHitTestVisible="False">
            <Grid>
                <TextBlock Text="{Binding Kind}" FontFamily="{DynamicResource MonoFont}"
                           FontSize="8" Foreground="{DynamicResource TextDisabledBrush}"
                           Margin="8,6,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
                <TextBlock Text="容器子控件在预览中重排" FontSize="7"
                           Foreground="{DynamicResource TextDisabledBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="DesignCardTemplate">
        <controls:GlassCard Width="{Binding Width}" Height="{Binding Height}"
                            CornerRadius="{Binding CornerRadius}"
                            Padding="16"
                            IsHitTestVisible="False">
            <TextBlock Text="{Binding Text}"
                       FontFamily="{Binding FontFamily, Converter={StaticResource StringToFontFamily}}"
                       FontSize="{Binding FontSize}"
                       FontWeight="{Binding IsBold, Converter={StaticResource BoolToFontWeight}}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" />
        </controls:GlassCard>
    </DataTemplate>

    <DataTemplate x:Key="DesignDividerTemplate">
        <Grid Width="{Binding Width}" Height="{Binding Height}" IsHitTestVisible="False">
            <Border Height="1" VerticalAlignment="Center"
                    Background="{DynamicResource DividerBrush}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DesignCheckBoxTemplate">
        <CheckBox Width="{Binding Width}" Height="{Binding Height}"
                  Style="{StaticResource FrostCheckBoxStyle}"
                  Content="{Binding Text}"
                  IsChecked="{Binding IsOn, Mode=OneWay}"
                  IsEnabled="{Binding IsEnabled}"
                  IsHitTestVisible="False"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="DesignRadioTemplate">
        <RadioButton Width="{Binding Width}" Height="{Binding Height}"
                     Style="{StaticResource FrostRadioButtonStyle}"
                     Content="{Binding Text}"
                     IsChecked="{Binding IsOn, Mode=OneWay}"
                     GroupName="{Binding GroupName}"
                     IsEnabled="{Binding IsEnabled}"
                     IsHitTestVisible="False"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="DesignComboBoxTemplate">
        <ComboBox Width="{Binding Width}" Height="{Binding Height}"
                  Style="{StaticResource FrostComboBoxStyle}"
                  ItemsSource="{Binding ListItems, Converter={StaticResource StringLines}}"
                  SelectedItem="{Binding SelectedItem, Mode=OneWay}"
                  IsEnabled="{Binding IsEnabled}"
                  IsHitTestVisible="False" />
    </DataTemplate>

    <DataTemplate x:Key="DesignPasswordTemplate">
        <PasswordBox Width="{Binding Width}" Height="{Binding Height}"
                     Style="{StaticResource GlassPasswordBoxStyle}"
                     Password="••••••"
                     FontSize="{Binding FontSize}"
                     IsEnabled="{Binding IsEnabled}"
                     IsHitTestVisible="False" />
    </DataTemplate>

    <DataTemplate x:Key="DesignTextAreaTemplate">
        <TextBox Width="{Binding Width}" Height="{Binding Height}"
                 Style="{StaticResource GlassTextBoxStyle}"
                 Text="{Binding Text, Mode=OneWay}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 Padding="10,7"
                 FontSize="{Binding FontSize}"
                 IsEnabled="{Binding IsEnabled}"
                 IsHitTestVisible="False" />
    </DataTemplate>

    <DataTemplate x:Key="DesignNumberTemplate">
        <Grid Width="{Binding Width}" Height="{Binding Height}" IsHitTestVisible="False">
            <TextBox Style="{StaticResource GlassTextBoxStyle}"
                     Text="{Binding Value, StringFormat={}{0:0.####}, Mode=OneWay}"
                     Padding="10,0,28,0"
                     FontSize="{Binding FontSize}"
                     IsEnabled="{Binding IsEnabled}" />
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,7,0">
                <TextBlock Text="▲" FontSize="6" Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Text="▼" FontSize="6" Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DesignDateTemplate">
        <Grid Width="{Binding Width}" Height="{Binding Height}" IsHitTestVisible="False">
            <TextBox Style="{StaticResource GlassTextBoxStyle}"
                     Text="{Binding Text, Mode=OneWay}"
                     Padding="10,0,30,0"
                     FontSize="{Binding FontSize}"
                     IsEnabled="{Binding IsEnabled}" />
            <TextBlock Text="日" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,10,0" FontSize="12"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DesignSearchTemplate">
        <Border Width="{Binding Width}" Height="{Binding Height}"
                CornerRadius="9" ClipToBounds="True"
                Background="{DynamicResource InputBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}"
                BorderThickness="1"
                IsHitTestVisible="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="⌕" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBox Grid.Column="1" Style="{StaticResource SearchTextBoxStyle}"
                         Text="{Binding Text, Mode=OneWay}"
                         FontSize="{Binding FontSize}"
                         IsEnabled="{Binding IsEnabled}" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="DesignTabsTemplate">
        <Border Width="{Binding Width}" Height="{Binding Height}"
                CornerRadius="{Binding CornerRadius}" ClipToBounds="True"
                Background="{DynamicResource InsetSurfaceBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                IsHitTestVisible="False">
            <TabControl Style="{StaticResource FrostTabControlStyle}"
                        ItemsSource="{Binding ListItems, Converter={StaticResource StringLines}}"
                        SelectedIndex="{Binding SelectedIndex, Mode=OneWay}">
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="DesignExpanderTemplate">
        <Border Width="{Binding Width}" Height="{Binding Height}"
                CornerRadius="{Binding CornerRadius}" ClipToBounds="True"
                Background="{DynamicResource InsetSurfaceBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                Padding="10,7" IsHitTestVisible="False">
            <Expander Header="{Binding Text}" IsExpanded="{Binding IsOn, Mode=OneWay}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      Background="Transparent" BorderThickness="0">
                <TextBlock Text="子控件在预览中按画布坐标显示"
                           FontSize="7.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextDisabledBrush}" />
            </Expander>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="DesignSplitViewTemplate">
        <Border Width="{Binding Width}" Height="{Binding Height}"
                CornerRadius="{Binding CornerRadius}" ClipToBounds="True"
                Background="{DynamicResource InsetSurfaceBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                IsHitTestVisible="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="面板 1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}" FontSize="8" />
                <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" />
                <TextBlock Grid.Column="2" Text="面板 2" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}" FontSize="8" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="DesignMenuTemplate">
        <Border Width="{Binding Width}" Height="{Binding Height}"
                CornerRadius="9" Padding="5,3"
                Background="{DynamicResource ToastBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                IsHitTestVisible="False">
            <ItemsControl ItemsSource="{Binding ListItems, Converter={StaticResource StringLines}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Margin="8,0"
                                   VerticalAlignment="Center" FontSize="9"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="DesignInfoBarTemplate">
        <Border Width="{Binding Width}" Height="{Binding Height}"
                CornerRadius="9" Padding="10,7"
                Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="i" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="0,0,8,0" />
                <TextBlock Text="{Binding Text}" FontSize="10" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="DesignDataGridTemplate">
        <Border Width="{Binding Width}" Height="{Binding Height}"
                CornerRadius="{Binding CornerRadius}" ClipToBounds="True"
                Background="{DynamicResource InsetSurfaceBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                IsHitTestVisible="False">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource InsetSurfaceStrongBrush}" Padding="8,0">
                    <TextBlock Text="{Binding TableColumns}" VerticalAlignment="Center"
                               FontSize="8" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding ListItems}" Margin="8,6"
                           FontSize="8" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="DesignTreeViewTemplate">
        <Border Width="{Binding Width}" Height="{Binding Height}"
                CornerRadius="{Binding CornerRadius}" ClipToBounds="True"
                Background="{DynamicResource InsetSurfaceBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                Padding="8,6" IsHitTestVisible="False">
            <ItemsControl ItemsSource="{Binding ListItems, Converter={StaticResource StringLines}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="9" Margin="0,2"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="DesignRepeaterTemplate">
        <Border Width="{Binding Width}" Height="{Binding Height}"
                CornerRadius="{Binding CornerRadius}" ClipToBounds="True"
                Background="{DynamicResource InsetSurfaceBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                Padding="7" IsHitTestVisible="False">
            <ItemsControl ItemsSource="{Binding ListItems, Converter={StaticResource StringLines}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource InputBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="8,5" Margin="0,0,0,4">
                            <TextBlock Text="{Binding}" FontSize="9"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="DesignChartTemplate">
        <Border Width="{Binding Width}" Height="{Binding Height}"
                CornerRadius="{Binding CornerRadius}" ClipToBounds="True"
                Background="{DynamicResource InsetSurfaceBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                IsHitTestVisible="False">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding ChartType, StringFormat=图表 · {0}}"
                           FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom"
                            Margin="0,10,0,0">
                    <Border Width="24" Height="35" CornerRadius="4" Background="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                    <Border Width="24" Height="55" CornerRadius="4" Background="{DynamicResource SuccessBrush}" Margin="0,0,6,0" />
                    <Border Width="24" Height="28" CornerRadius="4" Background="{DynamicResource WarningBrush}" Margin="0,0,6,0" />
                    <Border Width="24" Height="45" CornerRadius="4" Background="{DynamicResource DangerBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <views:DesignControlTemplateSelector x:Key="DesignControlTemplateSelector"
                                          ButtonTemplate="{StaticResource DesignButtonTemplate}"
                                          LabelTemplate="{StaticResource DesignLabelTemplate}"
                                          TextBoxTemplate="{StaticResource DesignTextBoxTemplate}"
                                          PasswordTemplate="{StaticResource DesignPasswordTemplate}"
                                          TextAreaTemplate="{StaticResource DesignTextAreaTemplate}"
                                          SearchTemplate="{StaticResource DesignSearchTemplate}"
                                          NumberTemplate="{StaticResource DesignNumberTemplate}"
                                          DateTemplate="{StaticResource DesignDateTemplate}"
                                          ComboBoxTemplate="{StaticResource DesignComboBoxTemplate}"
                                          CheckBoxTemplate="{StaticResource DesignCheckBoxTemplate}"
                                          RadioTemplate="{StaticResource DesignRadioTemplate}"
                                          ToggleTemplate="{StaticResource DesignToggleTemplate}"
                                          SliderTemplate="{StaticResource DesignSliderTemplate}"
                                          ProgressBarTemplate="{StaticResource DesignProgressBarTemplate}"
                                          ProgressRingTemplate="{StaticResource DesignProgressRingTemplate}"
                                          CardTemplate="{StaticResource DesignCardTemplate}"
                                          ImageTemplate="{StaticResource DesignImageTemplate}"
                                          ContainerTemplate="{StaticResource DesignContainerTemplate}"
                                          TabsTemplate="{StaticResource DesignTabsTemplate}"
                                          ExpanderTemplate="{StaticResource DesignExpanderTemplate}"
                                          SplitViewTemplate="{StaticResource DesignSplitViewTemplate}"
                                          MenuTemplate="{StaticResource DesignMenuTemplate}"
                                          InfoBarTemplate="{StaticResource DesignInfoBarTemplate}"
                                          DataGridTemplate="{StaticResource DesignDataGridTemplate}"
                                          TreeViewTemplate="{StaticResource DesignTreeViewTemplate}"
                                          RepeaterTemplate="{StaticResource DesignRepeaterTemplate}"
                                          ChartTemplate="{StaticResource DesignChartTemplate}"
                                          ListTemplate="{StaticResource DesignListTemplate}"
                                          DividerTemplate="{StaticResource DesignDividerTemplate}" />

    <DataTemplate x:Key="DesignItemTemplate">
        <Grid Width="{Binding Width}" Height="{Binding Height}"
              Background="Transparent"
              Visibility="{Binding IsCanvasVisible, Converter={StaticResource DesignBoolToVis}}"
              IsHitTestVisible="{Binding IsVisible}">
            <ContentControl Content="{Binding}"
                            ContentTemplateSelector="{StaticResource DesignControlTemplateSelector}"
                            Opacity="{Binding IsVisible, Converter={StaticResource BoolToOpacity}}" />

            <Border BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1.5"
                    CornerRadius="3"
                    IsHitTestVisible="False"
                    Visibility="{Binding IsSelected, Converter={StaticResource DesignBoolToVis}}" />

            <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                    Margin="0,-20,0,0"
                    Background="{DynamicResource ToastBrush}"
                    BorderBrush="{DynamicResource AccentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="5,2"
                    IsHitTestVisible="False"
                    Panel.ZIndex="20"
                    Visibility="{Binding IsSelected, Converter={StaticResource DesignBoolToVis}}">
                <TextBlock Text="{Binding Name}"
                           FontSize="7.5"
                           Foreground="{DynamicResource AccentBrush}" />
            </Border>

            <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                    Margin="0,-20,-14,0"
                    Background="{DynamicResource ToastBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="4,1"
                    IsHitTestVisible="False"
                    Panel.ZIndex="21"
                    Visibility="{Binding IsLocked, Converter={StaticResource DesignBoolToVis}}">
                <TextBlock Text="锁定" FontSize="6.5"
                           Foreground="{DynamicResource WarningBrush}" />
            </Border>

            <Grid Width="18" Height="18"
                  Tag="Resize"
                  Background="Transparent"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,-8,-8"
                  Cursor="SizeNWSE"
                  ToolTip="拖动调整宽高"
                  Panel.ZIndex="30"
                  Visibility="{Binding IsSelected, Converter={StaticResource DesignBoolToVis}}">
                <Border Width="9" Height="9"
                        CornerRadius="2"
                        Background="{DynamicResource AccentBrush}"
                        BorderBrush="White"
                        BorderThickness="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,2,2" />
            </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
