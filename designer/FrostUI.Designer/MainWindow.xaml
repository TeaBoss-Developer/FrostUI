<ui:FrostWindow x:Class="FrostUI.Designer.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:FrostUI.Controls;assembly=FrostUI"
                xmlns:views="clr-namespace:FrostUI.Designer.Views"
                Title="FrostUI Designer"
                Width="1500" Height="940"
                MinWidth="1240" MinHeight="820"
                WindowStartupLocation="CenterScreen"
                Style="{StaticResource FrostWindowStyle}"
                Backdrop="Acrylic"
                TintOpacity="0.30"
                FontFamily="{DynamicResource UiFont}"
                Loaded="Window_OnLoaded"
                Closing="Window_OnClosing">

    <ui:FrostWindow.TitleBarContent>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="{DynamicResource AccentSoftBrush}"
                    BorderBrush="{DynamicResource AccentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="7,2">
                <TextBlock Text="DESIGNER"
                           FontFamily="{DynamicResource MonoFont}"
                           FontSize="7.5"
                           Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <TextBlock Text="可视化布局 · 控件事件脚本"
                       FontSize="10"
                       Margin="9,0,0,0"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>
    </ui:FrostWindow.TitleBarContent>

    <Grid>
        <Grid IsHitTestVisible="False">
            <Ellipse Width="720" Height="720" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-420,-220,0" Fill="{DynamicResource AmbientBlueBrush}" />
            <Ellipse Width="520" Height="520" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-250,0,0,-300" Fill="{DynamicResource AmbientVioletBrush}" />
            <Ellipse Width="420" Height="420" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-140,-250" Fill="{DynamicResource AmbientTealBrush}" />
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
                <RowDefinition Height="254" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- ================= Toolbar ================= -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="29" Height="29" CornerRadius="8"
                                Background="{DynamicResource BrandGradientBrush}">
                            <TextBlock Text="✦" FontSize="13" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ProjectNameText"
                                           Text="{Binding Name}"
                                           FontFamily="{DynamicResource DisplayFont}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Ellipse x:Name="DirtyDot" Width="5" Height="5"
                                         Fill="{DynamicResource WarningBrush}"
                                         Margin="6,0,0,0"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed"
                                         ToolTip="有未保存的更改" />
                            </StackPanel>
                            <TextBlock Text="FROSTUI DESIGNER / DESIGN MODE"
                                       FontFamily="{DynamicResource MonoFont}"
                                       FontSize="7"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Height="30"
                                MinWidth="0" Padding="9,0" Click="NewProject_OnClick" ToolTip="新建设计 (Ctrl+N)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFont}" FontSize="9"
                                           Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="新建" FontSize="10" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButtonStyle}" Height="30"
                                MinWidth="0" Padding="9,0" Margin="3,0,0,0" Click="OpenProject_OnClick" ToolTip="打开设计 (Ctrl+O)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="{DynamicResource IconFont}" FontSize="10"
                                           Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="打开" FontSize="10" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButtonStyle}" Height="30"
                                MinWidth="0" Padding="9,0" Margin="1,0,0,0" Click="SaveProject_OnClick" ToolTip="保存设计 (Ctrl+S)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="{DynamicResource IconFont}" FontSize="10"
                                           Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="保存" FontSize="10" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="18" Background="{DynamicResource DividerBrush}" Margin="7,0" />

                        <Button x:Name="UndoButton" Style="{StaticResource IconButtonStyle}"
                                Content="&#xE7A7;" FontSize="12" IsEnabled="False"
                                ToolTip="撤销 (Ctrl+Z)" Click="Undo_OnClick" />
                        <Button x:Name="RedoButton" Style="{StaticResource IconButtonStyle}"
                                Content="&#xE7A6;" FontSize="12" IsEnabled="False"
                                ToolTip="重做 (Ctrl+Y)" Click="Redo_OnClick" />
                        <Button x:Name="HistoryButton" Style="{StaticResource GhostButtonStyle}"
                                Height="26" MinWidth="0" Padding="7,0" Margin="2,0,0,0"
                                Content="历史" FontSize="9"
                                ToolTip="查看编辑历史" Click="HistoryButton_OnClick" />

                        <Border Width="1" Height="18" Background="{DynamicResource DividerBrush}" Margin="7,0" />

                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE8C8;"
                                ToolTip="复制选中控件 (Ctrl+D)" Click="DuplicateControl_OnClick" />
                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE74D;"
                                ToolTip="删除选中控件 (Delete)" Click="DeleteControl_OnClick" />
                        <Border Width="1" Height="18" Background="{DynamicResource DividerBrush}" Margin="7,0" />

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:GlassToggleSwitch x:Name="GridToggle" Width="42" Height="22"
                                                  IsChecked="True"
                                                  Checked="GridToggle_OnChanged"
                                                  Unchecked="GridToggle_OnChanged"
                                                  ToolTip="显示网格并吸附到 8px" />
                            <TextBlock Text="网格" FontSize="9.5" Margin="6,0,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButtonStyle}" Height="30"
                                MinWidth="0" Padding="9,0"
                                Click="SelectWindow_OnClick" ToolTip="编辑窗口属性">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE737;" FontFamily="{DynamicResource IconFont}" FontSize="10"
                                           Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="窗口" FontSize="10" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="LayersButton" Style="{StaticResource GhostButtonStyle}" Height="30"
                                MinWidth="0" Padding="9,0" Margin="4,0,0,0"
                                Click="LayersButton_OnClick" ToolTip="图层、锁定、隐藏与层级顺序">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81E;" FontFamily="{DynamicResource IconFont}" FontSize="10"
                                           Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="图层" FontSize="10" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AlignButton" Style="{StaticResource GhostButtonStyle}" Height="30"
                                MinWidth="0" Padding="9,0" Margin="4,0,0,0"
                                Click="AlignButton_OnClick" ToolTip="对齐与等距分布">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A9;" FontFamily="{DynamicResource IconFont}" FontSize="10"
                                           Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="对齐" FontSize="10" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExportExeButton" Style="{StaticResource GhostButtonStyle}" Height="30"
                                MinWidth="0" Padding="9,0" Margin="4,0,0,0"
                                Click="ExportExe_OnClick" ToolTip="导出独立 EXE release">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B5;" FontFamily="{DynamicResource IconFont}" FontSize="10"
                                           Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="导出 EXE" FontSize="10" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ThemeButton" Style="{StaticResource IconButtonStyle}"
                                Width="30" Height="30" Margin="4,0,0,0"
                                Click="ThemeButton_OnClick" ToolTip="切换深色 / 浅色">
                            <TextBlock x:Name="ThemeGlyph" Text="&#xE706;"
                                       FontFamily="{DynamicResource IconFont}" FontSize="12" />
                        </Button>
                        <Button x:Name="ThemeColorButton" Style="{StaticResource IconButtonStyle}"
                                Width="30" Height="30" Margin="4,0,0,0"
                                Click="ThemeColorButton_OnClick" ToolTip="主题色">
                            <TextBlock Text="&#xE790;"
                                       FontFamily="{DynamicResource IconFont}" FontSize="12" />
                        </Button>
                        <Button x:Name="PreviewButton" Style="{StaticResource PrimaryButtonStyle}" Height="32"
                                MinWidth="0" Padding="14,0" Margin="9,0,0,0"
                                Click="RunPreview_OnClick" ToolTip="运行预览 (F5)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{DynamicResource IconFont}" FontSize="9"
                                           Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="运行预览" FontSize="10.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= Main work area ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="214" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="326" />
                </Grid.ColumnDefinitions>

                <!-- Toolbox -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="14,14,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="页面" Style="{StaticResource SectionTitleTextStyle}" FontSize="11" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="PageSelector" Height="82" FontSize="9"
                                         Style="{StaticResource LayerListStyle}"
                                         DisplayMemberPath="Name"
                                         SelectionChanged="PageSelector_OnSelectionChanged" />
                                <Button Grid.Column="1" Style="{StaticResource MiniActionButtonStyle}"
                                        Content="+" Margin="5,0,0,0" Click="AddPage_OnClick" />
                                <Button Grid.Column="2" Style="{StaticResource MiniActionButtonStyle}"
                                        Content="删" Margin="5,0,0,0" Click="DeletePage_OnClick" />
                            </Grid>
                            <TextBox x:Name="PageNameBox" Style="{StaticResource InspectorFieldStyle}"
                                     Margin="0,5,0,0" FontSize="8"
                                     Text="{Binding ActivePage.Name, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="当前页面名称" />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Button Style="{StaticResource MiniActionButtonStyle}"
                                        Content="复制" Click="CopyPage_OnClick" />
                                <Button Style="{StaticResource MiniActionButtonStyle}"
                                        Content="↑" Margin="4,0,0,0" Click="MovePageUp_OnClick" />
                                <Button Style="{StaticResource MiniActionButtonStyle}"
                                        Content="↓" Margin="4,0,0,0" Click="MovePageDown_OnClick" />
                            </StackPanel>

                            <TextBlock Text="控件库" Style="{StaticResource SectionTitleTextStyle}"
                                       FontSize="13" Margin="0,10,0,0" />
                            <TextBlock Text="拖到画板，或双击快速添加"
                                       FontSize="8.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" Margin="0,12,0,8"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ToolboxPanel"
                                        PreviewMouseLeftButtonDown="Toolbox_OnPreviewMouseLeftButtonDown"
                                        PreviewMouseMove="Toolbox_OnPreviewMouseMove"
                                        MouseLeftButtonDown="Toolbox_OnMouseLeftButtonDown">
                                <TextBlock Text="基 础" Style="{StaticResource EyebrowTextStyle}" Margin="2,0,0,6" />
                                <ItemsControl x:Name="BasicTools" ItemTemplate="{StaticResource ToolTileTemplate}" />

                                <TextBlock Text="表 单 · 交 互 · 数 据" Style="{StaticResource EyebrowTextStyle}" Margin="2,12,0,6" />
                                <ItemsControl x:Name="InteractiveTools" ItemTemplate="{StaticResource ToolTileTemplate}" />

                                <TextBlock Text="窗口设置" Style="{StaticResource EyebrowTextStyle}" Margin="2,12,0,6" />
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        Height="32" MinWidth="0" Padding="8,0"
                                        HorizontalContentAlignment="Left"
                                        Click="SelectWindow_OnClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE737;" FontFamily="{DynamicResource IconFont}"
                                                   FontSize="11" Width="22"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <TextBlock Text="窗口属性与材质" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ComponentsButton" Style="{StaticResource GhostButtonStyle}"
                                        Height="32" MinWidth="0" Padding="8,0" Margin="0,3,0,0"
                                        HorizontalContentAlignment="Left"
                                        Click="ComponentsButton_OnClick"
                                        ToolTip="保存/插入可复用控件组件">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource IconFont}"
                                                   FontSize="11" Width="22"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <TextBlock Text="组件 / 片段库" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                        <ui:GlassCard Grid.Row="2" CornerRadius="10" Padding="10,9">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="{DynamicResource IconFont}"
                                               FontSize="9" Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="操作提示" FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="拖动控件移动位置，右下角小方块调整宽高。事件逻辑在下方编辑。"
                                           FontSize="8"
                                           LineHeight="13"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </ui:GlassCard>
                    </Grid>
                </Border>

                <!-- Canvas -->
                <Grid Grid.Column="1" Background="{DynamicResource DesignerCanvasBrush}" ClipToBounds="True">
                    <Rectangle Fill="{StaticResource DesignerDotBrush}" Opacity="0.35" IsHitTestVisible="False" />
                    <Grid Margin="16,10,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="画板" FontFamily="{DynamicResource MonoFont}"
                                           FontSize="8" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding WindowSizeText}" FontFamily="{DynamicResource MonoFont}"
                                           FontSize="8" Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextDisabledBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource MiniActionButtonStyle}" Content="−"
                                        Width="24" Height="22" Click="ZoomOut_OnClick" ToolTip="缩小" />
                                <TextBlock x:Name="CanvasZoomText" Text="100%" Width="42"
                                           FontFamily="{DynamicResource MonoFont}" FontSize="7.5"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextAlignment="Center" VerticalAlignment="Center" />
                                <Button Style="{StaticResource MiniActionButtonStyle}" Content="+"
                                        Width="24" Height="22" Click="ZoomIn_OnClick" ToolTip="放大" />
                                <Button Style="{StaticResource MiniActionButtonStyle}" Content="适应"
                                        Height="22" Click="FitCanvas_OnClick" ToolTip="适应画布" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer x:Name="CanvasScroll" Grid.Row="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      PanningMode="Both"
                                      Loaded="CanvasScroll_OnLoaded"
                                      SizeChanged="CanvasScroll_OnSizeChanged"
                                      PreviewMouseWheel="CanvasScroll_OnPreviewMouseWheel"
                                      PreviewMouseDown="CanvasScroll_OnPreviewMouseDown"
                                      PreviewMouseMove="CanvasScroll_OnPreviewMouseMove"
                                      PreviewMouseUp="CanvasScroll_OnPreviewMouseUp">
                            <Grid x:Name="ArtboardHost" Margin="22"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Canvas x:Name="HorizontalRuler" Grid.Row="0" Grid.Column="1"
                                        Height="18" ClipToBounds="True"
                                        Cursor="SizeNS"
                                        Background="{DynamicResource InsetSurfaceBrush}"
                                        MouseLeftButtonDown="HorizontalRuler_OnMouseLeftButtonDown"
                                        MouseMove="Ruler_OnMouseMove"
                                        MouseLeftButtonUp="Ruler_OnMouseLeftButtonUp" />
                                <Canvas x:Name="VerticalRuler" Grid.Row="1" Grid.Column="0"
                                        Width="18" ClipToBounds="True"
                                        Cursor="SizeWE"
                                        Background="{DynamicResource InsetSurfaceBrush}"
                                        MouseLeftButtonDown="VerticalRuler_OnMouseLeftButtonDown"
                                        MouseMove="Ruler_OnMouseMove"
                                        MouseLeftButtonUp="Ruler_OnMouseLeftButtonUp" />

                            <Border x:Name="Artboard" Grid.Row="1" Grid.Column="1"
                                    Width="{Binding WindowWidth}"
                                    Height="{Binding WindowHeight}"
                                    CornerRadius="14"
                                    BorderBrush="{DynamicResource WindowEdgeBrush}"
                                    BorderThickness="1"
                                    Background="{DynamicResource FallbackWindowBrush}"
                                    SnapsToDevicePixels="True">
                                <Border.LayoutTransform>
                                    <ScaleTransform x:Name="ArtboardScale" ScaleX="1" ScaleY="1" />
                                </Border.LayoutTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="38" ShadowDepth="16" Direction="270"
                                                      Color="#B0000000" Opacity="0.5" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="54" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Mock window titlebar -->
                                    <Border Background="{DynamicResource TitleBarBrush}"
                                            BorderBrush="{DynamicResource TitleBarBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            CornerRadius="13,13,0,0"
                                            MouseLeftButtonDown="ArtboardTitleBar_OnMouseLeftButtonDown">
                                        <Grid Margin="14,0,10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Width="22" Height="22"
                                                            ContentTemplate="{DynamicResource FrostLogoMarkTemplate}"
                                                            VerticalAlignment="Center"
                                                            IsHitTestVisible="False" />
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        IsHitTestVisible="False">
                                                <TextBlock Text="{Binding WindowTitle}"
                                                           FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                        VerticalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock Text="&#xE921;" FontFamily="{DynamicResource IconFont}"
                                                           FontSize="7" Margin="8,0"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                                <TextBlock Text="&#xE922;" FontFamily="{DynamicResource IconFont}"
                                                           FontSize="7" Margin="8,0"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                                <TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource IconFont}"
                                                           FontSize="7" Margin="8,0"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Design surface -->
                                    <Grid Grid.Row="1" Background="{DynamicResource FallbackWindowBrush}" ClipToBounds="True">
                                        <Border Background="{DynamicResource WindowSurfaceBrush}" />
                                        <Ellipse Width="580" Height="580" HorizontalAlignment="Right"
                                                 VerticalAlignment="Top" Margin="0,-320,-170,0"
                                                 Fill="{DynamicResource AmbientBlueBrush}"
                                                 IsHitTestVisible="False" />
                                        <Ellipse Width="440" Height="440" HorizontalAlignment="Left"
                                                 VerticalAlignment="Bottom" Margin="-220,0,0,-250"
                                                 Fill="{DynamicResource AmbientVioletBrush}"
                                                 IsHitTestVisible="False" />

                                        <Rectangle x:Name="GridOverlay"
                                                   Fill="{StaticResource DesignerGridBrush}"
                                                   IsHitTestVisible="False"
                                                   Visibility="Visible" />

                                        <TextBlock Text="拖入控件开始设计"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="30" FontWeight="Light"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Opacity="0.12"
                                                   Visibility="{Binding HasControls, Converter={StaticResource InverseBoolToVis}}"
                                                   IsHitTestVisible="False" />

                                        <ItemsControl x:Name="ControlItems"
                                                      Width="{Binding WindowWidth, Mode=OneWay}"
                                                      Height="{Binding ContentHeight, Mode=OneWay}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Top"
                                                      Background="Transparent"
                                                      AllowDrop="True"
                                                      ItemsSource="{Binding Controls}"
                                                      ItemTemplate="{StaticResource DesignItemTemplate}"
                                                      PreviewMouseLeftButtonDown="ControlItems_OnPreviewMouseLeftButtonDown"
                                                      PreviewMouseMove="ControlItems_OnPreviewMouseMove"
                                                      PreviewMouseLeftButtonUp="ControlItems_OnPreviewMouseLeftButtonUp"
                                                      DragOver="ControlItems_OnDragOver"
                                                      Drop="ControlItems_OnDrop">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="{x:Type ContentPresenter}">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                        </ItemsControl>

                                        <Canvas x:Name="UserGuideLayer" IsHitTestVisible="True"
                                                Panel.ZIndex="39"
                                                PreviewMouseLeftButtonDown="UserGuideLayer_OnPreviewMouseLeftButtonDown"
                                                PreviewMouseMove="UserGuideLayer_OnPreviewMouseMove"
                                                PreviewMouseLeftButtonUp="UserGuideLayer_OnPreviewMouseLeftButtonUp"
                                                MouseRightButtonDown="UserGuideLayer_OnMouseRightButtonDown" />

                                        <Canvas x:Name="GuideLayer" IsHitTestVisible="False"
                                                Panel.ZIndex="40" />

                                        <Rectangle x:Name="SelectionBox"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                                   Fill="{DynamicResource AccentSoftBrush}"
                                                   Stroke="{DynamicResource AccentBrush}"
                                                   StrokeThickness="1"
                                                   StrokeDashArray="4,2"
                                                   Panel.ZIndex="50"
                                                   Visibility="Collapsed"
                                                   IsHitTestVisible="False" />

                                        <TextBlock Text="Ctrl+D 复制 · Delete 删除 · 方向键微调"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                   Margin="0,0,0,9"
                                                   FontFamily="{DynamicResource MonoFont}"
                                                   FontSize="7"
                                                   Foreground="{DynamicResource TextDisabledBrush}"
                                                   Opacity="0.8"
                                                   IsHitTestVisible="False" />
                                    </Grid>
                                </Grid>
                            </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Inspector -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1,0,0,0">
                    <Grid Margin="14,14,14,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="1,0,1,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="检查器" Style="{StaticResource SectionTitleTextStyle}" FontSize="13" />
                                <Border Background="{DynamicResource InsetSurfaceBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="5,1"
                                        Margin="7,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="PROPERTIES"
                                               FontFamily="{DynamicResource MonoFont}"
                                               FontSize="6.5"
                                               Foreground="{DynamicResource TextDisabledBrush}" />
                                </Border>
                            </StackPanel>
                            <Button Style="{StaticResource GhostButtonStyle}" Height="24" MinWidth="0"
                                    Padding="8,0" HorizontalAlignment="Right"
                                    Click="SelectWindow_OnClick">
                                <TextBlock Text="窗口属性" FontSize="8.5" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <!-- Control inspector -->
                                <StackPanel x:Name="ControlInspector" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="34" Height="34" CornerRadius="9"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    BorderBrush="{DynamicResource AccentBorderBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding KindIcon}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding KindTitle}" FontSize="8.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButtonStyle}" Width="26" Height="26"
                                                    Content="&#xE8C8;" FontSize="10"
                                                    ToolTip="复制控件" Click="DuplicateControl_OnClick" />
                                            <Button Style="{StaticResource IconButtonStyle}" Width="26" Height="26"
                                                    Content="&#xE74D;" FontSize="10"
                                                    ToolTip="删除控件" Click="DeleteControl_OnClick" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource InspectorSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="基础" Style="{StaticResource InspectorSectionTitleStyle}" />
                                            <TextBlock Text="名称（脚本里使用这个名字）" Style="{StaticResource InspectorLabelStyle}" />
                                            <TextBox x:Name="InspectorNameBox"
                                                     Style="{StaticResource InspectorFieldStyle}"
                                                     Margin="0,5,0,0"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     GotFocus="InspectorNameBox_OnGotFocus"
                                                     LostFocus="InspectorNameBox_OnLostFocus" />
                                            <TextBlock Text="类型" Style="{StaticResource InspectorLabelStyle}" Margin="0,9,0,0" />
                                            <TextBlock Text="{Binding KindTitle}" FontSize="10.5"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource InspectorSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="布局" Style="{StaticResource InspectorSectionTitleStyle}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="X" Style="{StaticResource InspectorLabelStyle}" />
                                                    <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                             Margin="0,4,0,0"
                                                             Text="{Binding X, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Y" Style="{StaticResource InspectorLabelStyle}" />
                                                    <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                             Margin="0,4,0,0"
                                                             Text="{Binding Y, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="宽度" Style="{StaticResource InspectorLabelStyle}" />
                                                    <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                             Margin="0,4,0,0"
                                                             Text="{Binding Width, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="高度" Style="{StaticResource InspectorLabelStyle}" />
                                                    <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                             Margin="0,4,0,0"
                                                             Text="{Binding Height, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="锚点（窗口变大时）" Style="{StaticResource InspectorLabelStyle}" Margin="0,8,0,0" />
                                            <ComboBox Margin="0,4,0,0" Height="28" IsEditable="True"
                                                      FontSize="9"
                                                      Background="{DynamicResource InsetSurfaceBrush}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      BorderBrush="{DynamicResource CardBorderBrush}"
                                                      Text="{Binding Anchor, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBoxItem Content="None" />
                                                <ComboBoxItem Content="Left" />
                                                <ComboBoxItem Content="Top" />
                                                <ComboBoxItem Content="Right" />
                                                <ComboBoxItem Content="Bottom" />
                                                <ComboBoxItem Content="RightBottom" />
                                                <ComboBoxItem Content="CenterX" />
                                                <ComboBoxItem Content="CenterY" />
                                                <ComboBoxItem Content="StretchHorizontal" />
                                                <ComboBoxItem Content="StretchVertical" />
                                                <ComboBoxItem Content="StretchAll" />
                                                <ComboBoxItem Content="StretchLeftRight" />
                                                <ComboBoxItem Content="StretchTopBottom" />
                                                <ComboBoxItem Content="Fill" />
                                            </ComboBox>
                                            <TextBlock Text="位置/尺寸绑定（全局变量）"
                                                       Style="{StaticResource InspectorLabelStyle}" Margin="0,6,0,0" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Style="{StaticResource InspectorFieldStyle}" ToolTip="X 绑定"
                                                         Text="{Binding XBinding, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox Grid.Column="2" Style="{StaticResource InspectorFieldStyle}" ToolTip="Y 绑定"
                                                         Text="{Binding YBinding, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox Grid.Column="4" Style="{StaticResource InspectorFieldStyle}" ToolTip="宽度绑定"
                                                         Text="{Binding WidthBinding, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox Grid.Column="6" Style="{StaticResource InspectorFieldStyle}" ToolTip="高度绑定"
                                                         Text="{Binding HeightBinding, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="左距 / 上距" Style="{StaticResource InspectorLabelStyle}" />
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                                 Text="{Binding MarginLeft, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                        <TextBox Grid.Column="2" Style="{StaticResource InspectorFieldStyle}"
                                                                 Text="{Binding MarginTop, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="右距 / 下距" Style="{StaticResource InspectorLabelStyle}" />
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                                 Text="{Binding MarginRight, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                        <TextBox Grid.Column="2" Style="{StaticResource InspectorFieldStyle}"
                                                                 Text="{Binding MarginBottom, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,7,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="最小宽 / 高" Style="{StaticResource InspectorLabelStyle}" />
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                                 Text="{Binding MinWidth, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                        <TextBox Grid.Column="2" Style="{StaticResource InspectorFieldStyle}"
                                                                 Text="{Binding MinHeight, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="最大宽 / 高（0=不限）" Style="{StaticResource InspectorLabelStyle}" />
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                                 Text="{Binding MaxWidth, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                        <TextBox Grid.Column="2" Style="{StaticResource InspectorFieldStyle}"
                                                                 Text="{Binding MaxHeight, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource InspectorSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="样式令牌" Style="{StaticResource InspectorSectionTitleStyle}" />
                                            <ComboBox x:Name="TokenComboBox" Margin="0,4,0,0"
                                                      Height="28" FontSize="9" DisplayMemberPath="Name"
                                                      SelectedValuePath="Name"
                                                      SelectedValue="{Binding StyleToken, Mode=TwoWay}"
                                                      SelectionChanged="TokenComboBox_OnSelectionChanged"
                                                      Background="{DynamicResource InsetSurfaceBrush}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      BorderBrush="{DynamicResource CardBorderBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource InspectorSectionStyle}"
                                            Visibility="{Binding SupportsListEditor, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="数据 / 选项" Style="{StaticResource InspectorSectionTitleStyle}" />
                                            <TextBox Style="{StaticResource InspectorFieldStyle}" Height="76"
                                                     Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="NoWrap"
                                                     VerticalContentAlignment="Top" Padding="8,5"
                                                     Text="{Binding ListItems, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="每行一个选项" />
                                            <StackPanel Visibility="{Binding SupportsSelectionEditor, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="选中项" Style="{StaticResource InspectorLabelStyle}" Margin="0,7,0,0" />
                                                <TextBox Style="{StaticResource InspectorFieldStyle}" Margin="0,4,0,0"
                                                         Text="{Binding SelectedItem, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="默认选中的选项文字，留空表示不选" />
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding SupportsSelectedIndexEditor, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="当前标签页（0 开始）" Style="{StaticResource InspectorLabelStyle}" Margin="0,7,0,0" />
                                                <TextBox Style="{StaticResource InspectorFieldStyle}" Margin="0,4,0,0"
                                                         Text="{Binding SelectedIndex, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding SupportsTableColumns, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="表格列（每行一列）" Style="{StaticResource InspectorLabelStyle}" Margin="0,7,0,0" />
                                                <TextBox Style="{StaticResource InspectorFieldStyle}" Height="56"
                                                         Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="NoWrap"
                                                         VerticalContentAlignment="Top" Padding="8,5"
                                                         Text="{Binding TableColumns, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding SupportsGridOptions, Converter={StaticResource BoolToVis}}">
                                                <Grid Height="30">
                                                    <TextBlock Text="双击编辑单元格" FontSize="9.5"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               VerticalAlignment="Center" />
                                                    <ui:GlassToggleSwitch HorizontalAlignment="Right" Width="40" Height="22"
                                                                          IsChecked="{Binding GridEditable, Mode=TwoWay}" />
                                                </Grid>
                                                <Grid Height="30">
                                                    <TextBlock Text="点击表头排序" FontSize="9.5"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               VerticalAlignment="Center" />
                                                    <ui:GlassToggleSwitch HorizontalAlignment="Right" Width="40" Height="22"
                                                                          IsChecked="{Binding GridSortable, Mode=TwoWay}" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding SupportsChartType, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="图表类型" Style="{StaticResource InspectorLabelStyle}" Margin="0,7,0,0" />
                                                <ComboBox Margin="0,4,0,0" Height="28" IsEditable="True" FontSize="9"
                                                          Background="{DynamicResource InsetSurfaceBrush}"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          BorderBrush="{DynamicResource CardBorderBrush}"
                                                          Text="{Binding ChartType, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBoxItem Content="Bar" />
                                                    <ComboBoxItem Content="Line" />
                                                    <ComboBoxItem Content="Pie" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding SupportsSeverityEditor, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="通知级别" Style="{StaticResource InspectorLabelStyle}" Margin="0,7,0,0" />
                                                <ComboBox Margin="0,4,0,0" Height="28" IsEditable="True" FontSize="9"
                                                          Background="{DynamicResource InsetSurfaceBrush}"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          BorderBrush="{DynamicResource CardBorderBrush}"
                                                          Text="{Binding Severity, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBoxItem Content="Info" />
                                                    <ComboBoxItem Content="Success" />
                                                    <ComboBoxItem Content="Warning" />
                                                    <ComboBoxItem Content="Error" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding SupportsGroupEditor, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="单选组名" Style="{StaticResource InspectorLabelStyle}" Margin="0,7,0,0" />
                                                <TextBox Style="{StaticResource InspectorFieldStyle}" Margin="0,4,0,0"
                                                         Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="同一组名内的单选框互斥" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource InspectorSectionStyle}"
                                            Visibility="{Binding SupportsNumberEditor, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="数字范围" Style="{StaticResource InspectorSectionTitleStyle}" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="最小值" Style="{StaticResource InspectorLabelStyle}" />
                                                    <TextBox Style="{StaticResource InspectorFieldStyle}" Margin="0,4,0,0"
                                                             Text="{Binding Minimum, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.####}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="最大值" Style="{StaticResource InspectorLabelStyle}" />
                                                    <TextBox Style="{StaticResource InspectorFieldStyle}" Margin="0,4,0,0"
                                                             Text="{Binding Maximum, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.####}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="步长" Style="{StaticResource InspectorLabelStyle}" />
                                                    <TextBox Style="{StaticResource InspectorFieldStyle}" Margin="0,4,0,0"
                                                             Text="{Binding Step, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.####}}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource InspectorSectionStyle}"
                                            Visibility="{Binding SupportsValidationEditor, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="表单校验" Style="{StaticResource InspectorSectionTitleStyle}" />
                                            <TextBlock Text="规则" Style="{StaticResource InspectorLabelStyle}" />
                                            <ComboBox Margin="0,4,0,0" Height="28" IsEditable="True" FontSize="9"
                                                      Background="{DynamicResource InsetSurfaceBrush}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      BorderBrush="{DynamicResource CardBorderBrush}"
                                                      Text="{Binding ValidationRule, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBoxItem Content="None" />
                                                <ComboBoxItem Content="Required" />
                                                <ComboBoxItem Content="Email" />
                                                <ComboBoxItem Content="Number" />
                                            </ComboBox>
                                            <TextBlock Text="错误提示" Style="{StaticResource InspectorLabelStyle}" Margin="0,5,0,0" />
                                            <TextBox Style="{StaticResource InspectorFieldStyle}" Margin="0,4,0,0"
                                                     Text="{Binding ValidationMessage, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="留空使用内置提示" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource InspectorSectionStyle}"
                                            Visibility="{Binding SupportsTextEditor, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="内容" Style="{StaticResource InspectorSectionTitleStyle}" />
                                            <TextBlock Text="文本" Style="{StaticResource InspectorLabelStyle}" />
                                            <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                     Height="52"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     Padding="8,5"
                                                     Margin="0,4,0,0"
                                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Text="绑定全局变量（可选）" Style="{StaticResource InspectorLabelStyle}"
                                                       Margin="0,8,0,0"
                                                       Visibility="{Binding SupportsTextEditor, Converter={StaticResource BoolToVis}}" />
                                            <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                     Margin="0,4,0,0"
                                                     Text="{Binding TextBinding, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="例如 计数；事件执行后自动刷新文本"
                                                     Visibility="{Binding SupportsTextEditor, Converter={StaticResource BoolToVis}}" />
                                            <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                     Margin="0,4,0,0"
                                                     Text="{Binding TextBindingFormat, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="格式模板，例如：共 {0} 项；留空直接显示变量值"
                                                     Visibility="{Binding SupportsTextEditor, Converter={StaticResource BoolToVis}}" />
                                            <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                     Margin="0,4,0,0"
                                                     Text="{Binding TextBindingFallback, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="变量不存在时显示的文本"
                                                     Visibility="{Binding SupportsTextEditor, Converter={StaticResource BoolToVis}}" />

                                            <StackPanel Visibility="{Binding SupportsFontEditor, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,9,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="字号" Style="{StaticResource InspectorLabelStyle}" />
                                                        <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                                 Margin="0,4,0,0"
                                                                 Text="{Binding FontSize, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom"
                                                                Visibility="{Binding SupportsBoldEditor, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="粗体" Style="{StaticResource InspectorLabelStyle}" />
                                                        <ui:GlassToggleSwitch Width="44" Height="24" Margin="0,4,0,0"
                                                                              IsChecked="{Binding IsBold, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="字体" Style="{StaticResource InspectorLabelStyle}" Margin="0,8,0,0" />
                                                <ComboBox x:Name="InspectorFontFamilyBox" Margin="0,4,0,0"
                                                          Height="28" IsEditable="True" IsTextSearchEnabled="True"
                                                          FontSize="9"
                                                          Background="{DynamicResource InsetSurfaceBrush}"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          BorderBrush="{DynamicResource CardBorderBrush}"
                                                          Text="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource InspectorSectionStyle}"
                                            Visibility="{Binding SupportsImageEditor, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="图片资源" Style="{StaticResource InspectorSectionTitleStyle}" />
                                            <TextBlock Text="图片路径" Style="{StaticResource InspectorLabelStyle}" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                         Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="PNG / JPG / BMP / GIF" />
                                                <Button Grid.Column="1" Style="{StaticResource MiniActionButtonStyle}"
                                                        Content="选择" Margin="6,0,0,0"
                                                        Click="BrowseImage_OnClick" />
                                            </Grid>
                                            <TextBlock Text="缩放方式" Style="{StaticResource InspectorLabelStyle}"
                                                       Margin="0,8,0,0" />
                                            <ComboBox Margin="0,4,0,0" Height="28" IsEditable="True"
                                                      FontSize="9"
                                                      Background="{DynamicResource InsetSurfaceBrush}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      BorderBrush="{DynamicResource CardBorderBrush}"
                                                      Text="{Binding ImageStretch, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBoxItem Content="Uniform" />
                                                <ComboBoxItem Content="UniformToFill" />
                                                <ComboBoxItem Content="Fill" />
                                            </ComboBox>
                                            <TextBlock Text="图片绑定全局变量（可选）"
                                                       Style="{StaticResource InspectorLabelStyle}"
                                                       Margin="0,8,0,0" />
                                            <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                     Margin="0,4,0,0"
                                                     Text="{Binding ImageBinding, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="变量值应为图片路径；事件后自动更新" />
                                            <TextBlock Text="裁剪区域（左,上,右,下，0–1）"
                                                       Style="{StaticResource InspectorLabelStyle}"
                                                       Margin="0,8,0,0" />
                                            <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                     Margin="0,4,0,0"
                                                     Text="{Binding ImageCrop, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="例如 0,0,1,1 为完整图片；0,0,0.5,1 为左半边" />
                                            <TextBlock Text="导出时图片会复制到 release 的 assets 目录。"
                                                       FontSize="7.5" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextDisabledBrush}"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource InspectorSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="提示与菜单" Style="{StaticResource InspectorSectionTitleStyle}" />
                                            <TextBlock Text="悬停提示" Style="{StaticResource InspectorLabelStyle}" />
                                            <TextBox Style="{StaticResource InspectorFieldStyle}" Margin="0,4,0,0"
                                                     Text="{Binding ToolTipText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="鼠标悬停时显示的文字；留空不显示" />
                                            <TextBlock Text="右键菜单（每行一项）" Style="{StaticResource InspectorLabelStyle}" Margin="0,7,0,0" />
                                            <TextBox Style="{StaticResource InspectorFieldStyle}" Height="56"
                                                     Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="NoWrap"
                                                     VerticalContentAlignment="Top" Padding="8,5"
                                                     Text="{Binding ContextMenuItems, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="例如：复制\n粘贴\n删除" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource InspectorSectionStyle}"
                                            Visibility="{Binding SupportsAccentEditor, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="控件主题色" Style="{StaticResource InspectorSectionTitleStyle}" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                         Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="留空跟随全局主题；例如 #84AEFF" />
                                                <Button Grid.Column="1" Content="选色"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Height="30" MinWidth="52" Padding="8,0"
                                                        Margin="6,0,0,0"
                                                        Click="ControlAccent_OnClick" />
                                            </Grid>
                                            <TextBlock Text="留空 = 跟随全局主题色"
                                                       FontSize="7.5" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextDisabledBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource InspectorSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="容器" Style="{StaticResource InspectorSectionTitleStyle}" />
                                            <TextBlock Text="父容器" Style="{StaticResource InspectorLabelStyle}" />
                                            <ComboBox x:Name="ParentContainerBox" Margin="0,4,0,0"
                                                      Height="28" IsEditable="True" FontSize="9"
                                                      Background="{DynamicResource InsetSurfaceBrush}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      BorderBrush="{DynamicResource CardBorderBrush}"
                                                      SelectedItem="{Binding ParentName, Mode=TwoWay}" />
                                            <Grid Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="标签页序号" Style="{StaticResource InspectorLabelStyle}" />
                                                    <TextBox Style="{StaticResource InspectorFieldStyle}" Margin="0,4,0,0"
                                                             Text="{Binding TabIndex, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                                                             ToolTip="父容器为标签页时，从 1 开始" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="分栏面板" Style="{StaticResource InspectorLabelStyle}" />
                                                    <TextBox Style="{StaticResource InspectorFieldStyle}" Margin="0,4,0,0"
                                                             Text="{Binding PaneIndex, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                                                             ToolTip="父容器为分栏时：0 = 左栏，1 = 右栏" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Visibility="{Binding IsContainer, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,6,0,0">
                                                <TextBlock Text="Stack 方向" Style="{StaticResource InspectorLabelStyle}" />
                                                <ComboBox Margin="0,4,0,0" Height="28" IsEditable="True" FontSize="9"
                                                          Background="{DynamicResource InsetSurfaceBrush}"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          BorderBrush="{DynamicResource CardBorderBrush}"
                                                          Text="{Binding StackOrientation, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBoxItem Content="Vertical" />
                                                    <ComboBoxItem Content="Horizontal" />
                                                </ComboBox>
                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Grid 行 / 列" Style="{StaticResource InspectorLabelStyle}" />
                                                        <Grid Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="6" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                                     Text="{Binding GridRows, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                            <TextBox Grid.Column="2" Style="{StaticResource InspectorFieldStyle}"
                                                                     Text="{Binding GridColumns, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                        </Grid>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="内边距 / 间距" Style="{StaticResource InspectorLabelStyle}" />
                                                        <Grid Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="6" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                                     Text="{Binding ContainerPadding, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                            <TextBox Grid.Column="2" Style="{StaticResource InspectorFieldStyle}"
                                                                     Text="{Binding ContainerSpacing, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding IsContainer, Converter={StaticResource InverseBoolToVis}}">
                                                <TextBlock Text="Dock 停靠 / Grid 行,列,跨行,跨列"
                                                           Style="{StaticResource InspectorLabelStyle}" Margin="0,6,0,0" />
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Style="{StaticResource InspectorFieldStyle}" ToolTip="Dock"
                                                             Text="{Binding DockMode, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBox Grid.Column="2" Style="{StaticResource InspectorFieldStyle}" ToolTip="行"
                                                             Text="{Binding GridRow, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                    <TextBox Grid.Column="4" Style="{StaticResource InspectorFieldStyle}" ToolTip="列"
                                                             Text="{Binding GridColumn, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                </Grid>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Style="{StaticResource InspectorFieldStyle}" ToolTip="跨行"
                                                             Text="{Binding GridRowSpan, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                    <TextBox Grid.Column="2" Style="{StaticResource InspectorFieldStyle}" ToolTip="跨列"
                                                             Text="{Binding GridColumnSpan, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource InspectorSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="行为" Style="{StaticResource InspectorSectionTitleStyle}" />
                                            <Grid Height="28">
                                                <TextBlock Text="可见" FontSize="9.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <ui:GlassToggleSwitch HorizontalAlignment="Right" Width="40" Height="22"
                                                                      IsChecked="{Binding IsVisible, Mode=TwoWay}" />
                                            </Grid>
                                            <Grid Height="30">
                                                <TextBlock Text="启用" FontSize="9.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <ui:GlassToggleSwitch HorizontalAlignment="Right" Width="40" Height="22"
                                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                            </Grid>
                                            <Grid Height="30">
                                                <TextBlock Text="锁定" FontSize="9.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <ui:GlassToggleSwitch HorizontalAlignment="Right" Width="40" Height="22"
                                                                      IsChecked="{Binding IsLocked, Mode=TwoWay}" />
                                            </Grid>
                                            <TextBlock Text="启用绑定（全局逻辑变量）" Style="{StaticResource InspectorLabelStyle}"
                                                       Margin="0,5,0,0" />
                                            <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                     Margin="0,4,0,0"
                                                     Text="{Binding EnabledBinding, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="数值/状态绑定" Style="{StaticResource InspectorLabelStyle}"
                                                       Margin="0,6,0,0" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Style="{StaticResource InspectorFieldStyle}" ToolTip="透明度 0–1"
                                                         Text="{Binding OpacityBinding, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox Grid.Column="2" Style="{StaticResource InspectorFieldStyle}" ToolTip="字号"
                                                         Text="{Binding FontSizeBinding, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox Grid.Column="4" Style="{StaticResource InspectorFieldStyle}" ToolTip="圆角"
                                                         Text="{Binding CornerRadiusBinding, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Style="{StaticResource InspectorFieldStyle}" ToolTip="数值 0–100"
                                                         Text="{Binding ValueBinding, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox Grid.Column="2" Style="{StaticResource InspectorFieldStyle}" ToolTip="开关状态 true/false"
                                                         Text="{Binding IsOnBinding, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                            <TextBlock Text="导航" Style="{StaticResource InspectorSectionTitleStyle}"
                                                       Margin="0,8,0,0" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="PageActionBox" Height="28" FontSize="9"
                                                          Background="{DynamicResource InsetSurfaceBrush}"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          BorderBrush="{DynamicResource CardBorderBrush}"
                                                          Text="{Binding PageAction, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBoxItem Content="None" />
                                                    <ComboBoxItem Content="Switch" />
                                                    <ComboBoxItem Content="Window" />
                                                    <ComboBoxItem Content="Dialog" />
                                                    <ComboBoxItem Content="Open" />
                                                    <ComboBoxItem Content="Close" />
                                                </ComboBox>
                                                <ComboBox x:Name="NavigationTargetBox" Grid.Column="2" Height="28" FontSize="9"
                                                          DisplayMemberPath="Name" SelectedValuePath="Id"
                                                          SelectedValue="{Binding TargetPageId, Mode=TwoWay}"
                                                          Background="{DynamicResource InsetSurfaceBrush}"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          BorderBrush="{DynamicResource CardBorderBrush}" />
                                            </Grid>
                                            <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                     Margin="0,4,0,0"
                                                     Text="{Binding NavigationArgs, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="导航参数：key=value;id=1" />
                                            <TextBlock Text="可见性绑定（全局逻辑变量）" Style="{StaticResource InspectorLabelStyle}"
                                                       Margin="0,5,0,0" />
                                            <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                     Margin="0,4,0,0"
                                                     Text="{Binding VisibilityBinding, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="变量为真/假时切换可见；例如 已登录" />

                                            <StackPanel Visibility="{Binding SupportsValueEditor, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,5,0,0">
                                                <Grid>
                                                    <TextBlock Text="值" Style="{StaticResource InspectorLabelStyle}" />
                                                    <TextBlock Text="{Binding Value, StringFormat={}{0:0}%}"
                                                               HorizontalAlignment="Right"
                                                               FontFamily="{DynamicResource MonoFont}"
                                                               FontSize="8.5"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Grid>
                                                <Slider Style="{StaticResource GlassSliderStyle}"
                                                        Minimum="0" Maximum="100"
                                                        Margin="0,2,0,0"
                                                        Visibility="{Binding SupportsSliderEditor, Converter={StaticResource BoolToVis}}"
                                                        Value="{Binding Value, Mode=TwoWay}" />
                                                <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                         Margin="0,4,0,0"
                                                         Text="{Binding Value, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.####}}"
                                                         Visibility="{Binding SupportsNumberEditor, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>

                                            <Grid Height="30"
                                                  Visibility="{Binding SupportsToggleEditor, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="开启 / 选中" FontSize="9.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <ui:GlassToggleSwitch HorizontalAlignment="Right" Width="40" Height="22"
                                                                      IsChecked="{Binding IsOn, Mode=TwoWay}" />
                                            </Grid>
                                            <Grid Height="30"
                                                  Visibility="{Binding SupportsExpandedEditor, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="展开" FontSize="9.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <ui:GlassToggleSwitch HorizontalAlignment="Right" Width="40" Height="22"
                                                                      IsChecked="{Binding IsOn, Mode=TwoWay}" />
                                            </Grid>

                                            <StackPanel Visibility="{Binding SupportsCornerEditor, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,4,0,0">
                                                <TextBlock Text="圆角" Style="{StaticResource InspectorLabelStyle}" />
                                                <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                         Margin="0,4,0,0"
                                                         Text="{Binding CornerRadius, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                            </StackPanel>
                                            <TextBlock Text="入场动画" Style="{StaticResource InspectorLabelStyle}" Margin="0,8,0,0" />
                                            <ComboBox Margin="0,4,0,0" Height="28" IsEditable="True"
                                                      FontSize="9"
                                                      Background="{DynamicResource InsetSurfaceBrush}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      BorderBrush="{DynamicResource CardBorderBrush}"
                                                      Text="{Binding Animation, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBoxItem Content="None" />
                                                <ComboBoxItem Content="FadeIn" />
                                                <ComboBoxItem Content="SlideUp" />
                                                <ComboBoxItem Content="ScaleIn" />
                                            </ComboBox>
                                            <Grid Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="时长 ms" Style="{StaticResource InspectorLabelStyle}" />
                                                    <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                             Margin="0,4,0,0"
                                                             Text="{Binding AnimationDurationMs, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="延迟 ms" Style="{StaticResource InspectorLabelStyle}" />
                                                    <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                             Margin="0,4,0,0"
                                                             Text="{Binding AnimationDelayMs, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                </StackPanel>
                                            </Grid>
                                            <CheckBox Content="循环播放" Margin="0,6,0,0" FontSize="9"
                                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                                      IsChecked="{Binding AnimationRepeat, Mode=TwoWay}" />
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Content="编辑动画时间线…" Height="28" Margin="0,7,0,0"
                                                    HorizontalAlignment="Left"
                                                    Click="Timeline_OnClick" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource AccentSoftBrush}"
                                            BorderBrush="{DynamicResource AccentBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="9,7">
                                        <TextBlock Text="在下方「事件脚本」中编写这个控件的点击 / 切换 / 输入逻辑。"
                                                   FontSize="8"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>

                                <!-- Window inspector -->
                                <StackPanel x:Name="WindowInspector">
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="34" Height="34" CornerRadius="9"
                                                    Background="{DynamicResource InsetSurfaceStrongBrush}">
                                                <TextBlock Text="&#xE737;" FontFamily="{DynamicResource IconFont}"
                                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="窗口属性" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="FrostWindow · 运行时预览"
                                                           FontSize="8.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource InspectorSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="当前页面" Style="{StaticResource InspectorSectionTitleStyle}" />
                                            <TextBlock Text="页面标题（留空继承工程）" Style="{StaticResource InspectorLabelStyle}" />
                                            <TextBox Style="{StaticResource InspectorFieldStyle}" Margin="0,4,0,0"
                                                     Text="{Binding ActivePage.Title, UpdateSourceTrigger=PropertyChanged}" />
                                            <Grid Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="页面宽 / 高（0=继承）" Style="{StaticResource InspectorLabelStyle}" />
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                                 Text="{Binding ActivePage.Width, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                        <TextBox Grid.Column="2" Style="{StaticResource InspectorFieldStyle}"
                                                                 Text="{Binding ActivePage.Height, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="页面类型" Style="{StaticResource InspectorLabelStyle}" />
                                                    <ComboBox Height="28" Margin="0,4,0,0" IsEditable="True" FontSize="9"
                                                              Background="{DynamicResource InsetSurfaceBrush}"
                                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                                              BorderBrush="{DynamicResource CardBorderBrush}"
                                                              Text="{Binding ActivePage.Kind, UpdateSourceTrigger=PropertyChanged}">
                                                        <ComboBoxItem Content="Page" />
                                                        <ComboBoxItem Content="Window" />
                                                        <ComboBoxItem Content="Dialog" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="弹窗形式" Style="{StaticResource InspectorLabelStyle}" />
                                                    <ComboBox Height="28" Margin="0,4,0,0" IsEditable="True" FontSize="9"
                                                              Background="{DynamicResource InsetSurfaceBrush}"
                                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                                              BorderBrush="{DynamicResource CardBorderBrush}"
                                                              Text="{Binding ActivePage.DialogDisplay, UpdateSourceTrigger=PropertyChanged}">
                                                        <ComboBoxItem Content="Window" />
                                                        <ComboBoxItem Content="Overlay" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="页面材质" Style="{StaticResource InspectorLabelStyle}" />
                                                    <ComboBox x:Name="PageBackdropBox" Height="28" Margin="0,4,0,0" FontSize="9"
                                                              SelectionChanged="PageBackdropBox_OnSelectionChanged"
                                                              Background="{DynamicResource InsetSurfaceBrush}"
                                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                                              BorderBrush="{DynamicResource CardBorderBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="页面色调透明度" Style="{StaticResource InspectorLabelStyle}" />
                                                    <TextBox Style="{StaticResource InspectorFieldStyle}" Margin="0,4,0,0"
                                                             Text="{Binding ActivePage.TintOpacity, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="进入转场" Style="{StaticResource InspectorLabelStyle}" />
                                                    <ComboBox Height="28" Margin="0,4,0,0" IsEditable="True" FontSize="9"
                                                              Background="{DynamicResource InsetSurfaceBrush}"
                                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                                              BorderBrush="{DynamicResource CardBorderBrush}"
                                                              Text="{Binding ActivePage.Transition, UpdateSourceTrigger=PropertyChanged}">
                                                        <ComboBoxItem Content="None" />
                                                        <ComboBoxItem Content="Fade" />
                                                        <ComboBoxItem Content="SlideLeft" />
                                                        <ComboBoxItem Content="SlideRight" />
                                                        <ComboBoxItem Content="Scale" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="转场时长 ms" Style="{StaticResource InspectorLabelStyle}" />
                                                    <TextBox Style="{StaticResource InspectorFieldStyle}" Margin="0,4,0,0"
                                                             Text="{Binding ActivePage.TransitionDurationMs, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource InspectorSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="信息" Style="{StaticResource InspectorSectionTitleStyle}" />
                                            <TextBlock Text="项目名称" Style="{StaticResource InspectorLabelStyle}" />
                                            <TextBox Style="{StaticResource InspectorFieldStyle}" Margin="0,4,0,0"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="窗口标题" Style="{StaticResource InspectorLabelStyle}" Margin="0,8,0,0" />
                                            <TextBox Style="{StaticResource InspectorFieldStyle}" Margin="0,4,0,0"
                                                     Text="{Binding WindowTitle, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="标题绑定全局变量（可选）" Style="{StaticResource InspectorLabelStyle}" Margin="0,8,0,0" />
                                            <TextBox Style="{StaticResource InspectorFieldStyle}" Margin="0,4,0,0"
                                                     Text="{Binding TitleBinding, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="事件执行后按变量值更新窗口标题" />
                                            <TextBlock Text="描述" Style="{StaticResource InspectorLabelStyle}" Margin="0,8,0,0" />
                                            <TextBox Style="{StaticResource InspectorFieldStyle}" Height="52"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top" Padding="8,5"
                                                     Margin="0,4,0,0"
                                                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource InspectorSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="设计令牌" Style="{StaticResource InspectorSectionTitleStyle}" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TokenNameBox" Style="{StaticResource InspectorFieldStyle}"
                                                         ToolTip="令牌名称" />
                                                <Button Grid.Column="1" Style="{StaticResource MiniActionButtonStyle}"
                                                        Content="保存选中" Margin="5,0,0,0"
                                                        Click="SaveToken_OnClick" />
                                            </Grid>
                                            <ListBox x:Name="TokenList" Height="84" Margin="0,6,0,0"
                                                     Style="{StaticResource LayerListStyle}"
                                                     DisplayMemberPath="Name" />
                                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                                    Content="应用令牌到选中" Margin="0,5,0,0"
                                                    HorizontalAlignment="Left"
                                                    Click="ApplyToken_OnClick" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource InspectorSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="发布信息" Style="{StaticResource InspectorSectionTitleStyle}" />
                                            <TextBlock Text="版本" Style="{StaticResource InspectorLabelStyle}" />
                                            <TextBox Style="{StaticResource InspectorFieldStyle}" Margin="0,4,0,0"
                                                     Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="公司 / 作者" Style="{StaticResource InspectorLabelStyle}" Margin="0,8,0,0" />
                                            <TextBox Style="{StaticResource InspectorFieldStyle}" Margin="0,4,0,0"
                                                     Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="应用图标" Style="{StaticResource InspectorLabelStyle}" Margin="0,8,0,0" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                         Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="PNG / ICO 文件路径" />
                                                <Button Grid.Column="1" Style="{StaticResource MiniActionButtonStyle}"
                                                        Content="选择" Margin="6,0,0,0"
                                                        Click="BrowseIcon_OnClick" />
                                            </Grid>
                                            <TextBlock Text="导出时复制到 release，并用于 Player 窗口图标。"
                                                       FontSize="7.5" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextDisabledBrush}"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource InspectorSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="窗口尺寸" Style="{StaticResource InspectorSectionTitleStyle}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="宽度" Style="{StaticResource InspectorLabelStyle}" />
                                                    <TextBox Style="{StaticResource InspectorFieldStyle}" Margin="0,4,0,0"
                                                             Text="{Binding WindowWidth, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="高度" Style="{StaticResource InspectorLabelStyle}" />
                                                    <TextBox Style="{StaticResource InspectorFieldStyle}" Margin="0,4,0,0"
                                                             Text="{Binding WindowHeight, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,8,0,0">
                                                <TextBlock Text="内容区域" Style="{StaticResource InspectorLabelStyle}" />
                                                <TextBlock HorizontalAlignment="Right"
                                                           FontFamily="{DynamicResource MonoFont}"
                                                           FontSize="8.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}">
                                                    <Run Text="{Binding WindowWidth, Mode=OneWay, StringFormat={}{0:0}}" />
                                                    <Run Text=" × " />
                                                    <Run Text="{Binding ContentHeight, Mode=OneWay, StringFormat={}{0:0}}" />
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource InspectorSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="响应式" Style="{StaticResource InspectorSectionTitleStyle}" />
                                            <Grid Height="30">
                                                <TextBlock Text="内容随窗口缩放" FontSize="9"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <ui:GlassToggleSwitch HorizontalAlignment="Right" Width="40" Height="22"
                                                                      IsChecked="{Binding ScaleContent, Mode=TwoWay}" />
                                            </Grid>
                                            <Grid Height="30">
                                                <TextBlock Text="启用控件锚点" FontSize="9"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <ui:GlassToggleSwitch HorizontalAlignment="Right" Width="40" Height="22"
                                                                      IsChecked="{Binding AnchorLayout, Mode=TwoWay}" />
                                            </Grid>
                                            <TextBlock Text="缩放用于整体适配；锚点用于窗口尺寸变化时按控件定位。"
                                                       FontSize="7.5" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextDisabledBrush}" />
                                            <TextBlock Text="响应式断点（宽度:fixed/scale/anchor）"
                                                       Style="{StaticResource InspectorLabelStyle}" Margin="0,8,0,0" />
                                            <TextBox Style="{StaticResource InspectorFieldStyle}" Margin="0,4,0,0"
                                                     Text="{Binding BreakpointSpec, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="例如 0:fixed,720:anchor,1080:scale" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource InspectorSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="画布网格" Style="{StaticResource InspectorSectionTitleStyle}" />
                                            <Grid Margin="0,5,0,0">
                                                <TextBlock Text="网格大小" Style="{StaticResource InspectorLabelStyle}"
                                                           VerticalAlignment="Center" />
                                                <TextBox Style="{StaticResource InspectorFieldStyle}"
                                                         Width="82" HorizontalAlignment="Right"
                                                         Text="{Binding GridSize, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
                                            </Grid>
                                            <TextBlock Text="修改后网格绘制和吸附同步；范围 2–64。"
                                                       FontSize="7.5" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextDisabledBrush}"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource InspectorSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="窗口材质" Style="{StaticResource InspectorSectionTitleStyle}" />
                                            <WrapPanel Margin="0,0,0,2">
                                                <RadioButton x:Name="WindowMaterialAcrylic" Content="Acrylic"
                                                             GroupName="WindowMaterial"
                                                             Style="{StaticResource GlassRadioButtonStyle}"
                                                             Tag="Acrylic" IsChecked="True"
                                                             Checked="WindowMaterial_OnChecked" />
                                                <RadioButton x:Name="WindowMaterialMica" Content="Mica"
                                                             GroupName="WindowMaterial"
                                                             Style="{StaticResource GlassRadioButtonStyle}"
                                                             Tag="Mica"
                                                             Checked="WindowMaterial_OnChecked" />
                                                <RadioButton x:Name="WindowMaterialMicaAlt" Content="Mica Alt"
                                                             GroupName="WindowMaterial"
                                                             Style="{StaticResource GlassRadioButtonStyle}"
                                                             Tag="MicaAlt"
                                                             Checked="WindowMaterial_OnChecked" />
                                                <RadioButton x:Name="WindowMaterialBlur" Content="Blur"
                                                             GroupName="WindowMaterial"
                                                             Style="{StaticResource GlassRadioButtonStyle}"
                                                             Tag="Blur"
                                                             Checked="WindowMaterial_OnChecked" />
                                                <RadioButton x:Name="WindowMaterialNone" Content="关闭"
                                                             GroupName="WindowMaterial"
                                                             Style="{StaticResource GlassRadioButtonStyle}"
                                                             Tag="None"
                                                             Checked="WindowMaterial_OnChecked" />
                                            </WrapPanel>

                                            <Grid Margin="0,8,0,0">
                                                <TextBlock Text="亚克力浓度" Style="{StaticResource InspectorLabelStyle}" />
                                                <TextBlock Text="{Binding TintOpacity, StringFormat={}{0:P0}}"
                                                           HorizontalAlignment="Right"
                                                           FontFamily="{DynamicResource MonoFont}"
                                                           FontSize="8.5"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Grid>
                                            <Slider Style="{StaticResource GlassSliderStyle}"
                                                    Minimum="0" Maximum="1"
                                                    Margin="0,2,0,0"
                                                    Value="{Binding TintOpacity, Mode=TwoWay}" />
                                            <TextBlock Text="真实材质由 DWM 合成；预览窗口会按此设置创建。"
                                                       FontSize="7.5"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource AccentSoftBrush}"
                                            BorderBrush="{DynamicResource AccentBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="9,7">
                                        <TextBlock Text="窗口启动脚本在下方编辑；点击画板空白处可以随时回到窗口属性。"
                                                   FontSize="8"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= Bottom dock ================= -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="14,10,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Script editor -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="24" CornerRadius="6"
                                        Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="&#xE943;" FontFamily="{DynamicResource IconFont}"
                                               FontSize="10" Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="事件脚本" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" Margin="7,0,0,0" />
                                <Border Background="{DynamicResource InsetSurfaceBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="6,1"
                                        Margin="9,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="ScriptTargetText" Text="窗口 · 启动"
                                               FontSize="7.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </Border>
                                <Border Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="5"
                                        Padding="6,1"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="ScriptEventText" Text="启动"
                                               FontFamily="{DynamicResource MonoFont}"
                                               FontSize="7"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="ScriptDiagnosticsText" Text="✓ 语法正确"
                                           FontFamily="{DynamicResource MonoFont}"
                                           FontSize="7" MaxWidth="220"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           VerticalAlignment="Center"
                                           Cursor="Hand"
                                           Margin="0,0,10,0"
                                           MouseLeftButtonDown="ScriptDiagnostics_OnMouseLeftButtonDown"
                                           ToolTip="实时语法检查；点击查看问题列表；Ctrl+Enter 可手动校验" />
                                <TextBlock Text="Ctrl+Space 联想"
                                           FontFamily="{DynamicResource MonoFont}"
                                           FontSize="7"
                                           Foreground="{DynamicResource TextDisabledBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <Button Style="{StaticResource MiniActionButtonStyle}"
                                        Content="格式化" Click="FormatScript_OnClick" ToolTip="格式化脚本 (Ctrl+Shift+F)" />
                                <Button x:Name="ScriptFindButton"
                                        Style="{StaticResource MiniActionButtonStyle}"
                                        Content="查找" Click="FindReplace_OnClick" ToolTip="查找 / 替换 (Ctrl+F)" />
                                <Button Style="{StaticResource MiniActionButtonStyle}"
                                        Content="调试" Click="DebugScript_OnClick" ToolTip="调试当前脚本 (F9 断点)" />
                                <Button Style="{StaticResource MiniActionButtonStyle}"
                                        Content="校验" Click="ValidateScript_OnClick" />
                                <Button Style="{StaticResource MiniActionButtonStyle}"
                                        Content="参考" Click="ScriptReference_OnClick" ToolTip="函数与控件参考" />
                                <Button Style="{StaticResource MiniActionButtonStyle}"
                                        Content="插入示例"
                                        Click="InsertFullExample_OnClick" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Margin="0,8,0,7"
                                Background="#21000000"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#14000000"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="0,0,1,0">
                                    <StackPanel Margin="0,9,0,0" HorizontalAlignment="Center">
                                        <TextBlock Text="S" FontFamily="{DynamicResource MonoFont}"
                                                   FontSize="6.5" Foreground="{DynamicResource TextDisabledBrush}" />
                                        <TextBlock Text="C" FontFamily="{DynamicResource MonoFont}"
                                                   FontSize="6.5" Foreground="{DynamicResource TextDisabledBrush}" />
                                        <TextBlock Text="R" FontFamily="{DynamicResource MonoFont}"
                                                   FontSize="6.5" Foreground="{DynamicResource TextDisabledBrush}" />
                                        <TextBlock Text="I" FontFamily="{DynamicResource MonoFont}"
                                                   FontSize="6.5" Foreground="{DynamicResource TextDisabledBrush}" />
                                        <TextBlock Text="P" FontFamily="{DynamicResource MonoFont}"
                                                   FontSize="6.5" Foreground="{DynamicResource TextDisabledBrush}" />
                                        <TextBlock Text="T" FontFamily="{DynamicResource MonoFont}"
                                                   FontSize="6.5" Foreground="{DynamicResource TextDisabledBrush}" />
                                    </StackPanel>
                                </Border>
                                <TextBox x:Name="ScriptEditor" Grid.Column="1"
                                         Style="{StaticResource CodeEditorTextBoxStyle}"
                                         TextChanged="ScriptEditor_OnTextChanged"
                                         SelectionChanged="ScriptEditor_OnSelectionChanged"
                                         PreviewKeyDown="ScriptEditor_OnPreviewKeyDown"
                                         PreviewMouseDown="ScriptEditor_OnPreviewMouseDown"
                                         MouseMove="ScriptEditor_OnMouseMove"
                                         MouseLeave="ScriptEditor_OnMouseLeave" />

                                <Canvas x:Name="ScriptOverlay" Grid.Column="1"
                                        IsHitTestVisible="False" ClipToBounds="True"
                                        Panel.ZIndex="15" />

                                <Border x:Name="SignatureHint" Grid.Column="1"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,6,36,0" Padding="8,3"
                                        Background="{DynamicResource ToastBrush}"
                                        BorderBrush="{DynamicResource AccentBorderBrush}"
                                        BorderThickness="1" CornerRadius="5"
                                        IsHitTestVisible="False" Panel.ZIndex="20"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="ScriptSignatureText"
                                               FontFamily="{DynamicResource MonoFont}"
                                               FontSize="7.5"
                                               Foreground="{DynamicResource AccentBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="430" />
                                </Border>

                                <Popup x:Name="CompletionPopup"
                                       PlacementTarget="{Binding ElementName=ScriptEditor}"
                                       Placement="Relative"
                                       AllowsTransparency="True"
                                       StaysOpen="False"
                                       PopupAnimation="Fade"
                                       Grid.ColumnSpan="2">
                                    <Border Width="355"
                                            MaxHeight="242"
                                            Background="{DynamicResource ToastBrush}"
                                            BorderBrush="{DynamicResource CardBorderStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270"
                                                              Color="#A0000000" Opacity="0.45" />
                                        </Border.Effect>
                                        <ListBox x:Name="CompletionList"
                                                 Style="{StaticResource CompletionListStyle}"
                                                 MouseDoubleClick="CompletionList_OnMouseDoubleClick"
                                                 PreviewKeyDown="CompletionList_OnPreviewKeyDown">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid AutomationProperties.Name="{Binding Display}"
                                                          AutomationProperties.HelpText="{Binding Detail}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="19" Height="19" CornerRadius="5"
                                                                Background="{DynamicResource AccentSoftBrush}"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Icon}"
                                                                       FontFamily="{DynamicResource MonoFont}"
                                                                       FontSize="8"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                                            <TextBlock Text="{Binding Display}"
                                                                       FontFamily="{DynamicResource MonoFont}"
                                                                       FontSize="10.5"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding Detail}"
                                                                       FontSize="8"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="插入：" FontSize="8"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" Margin="1,0,4,0" />
                                <Button Style="{StaticResource MiniActionButtonStyle}" Content="条件" Tag="condition" Click="InsertSnippet_OnClick" />
                                <Button Style="{StaticResource MiniActionButtonStyle}" Content="JSON" Tag="json" Click="InsertSnippet_OnClick" />
                                <Button Style="{StaticResource MiniActionButtonStyle}" Content="HTTP" Tag="http" Click="InsertSnippet_OnClick" />
                                <Button Style="{StaticResource MiniActionButtonStyle}" Content="计数" Tag="counter" Click="InsertSnippet_OnClick" />
                                <Button Style="{StaticResource MiniActionButtonStyle}" Content="改属性" Tag="property" Click="InsertSnippet_OnClick" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="BreakpointText" Text=""
                                           FontFamily="{DynamicResource MonoFont}" FontSize="7"
                                           Foreground="{DynamicResource DangerBrush}"
                                           Margin="0,0,10,0" />
                                <TextBlock x:Name="ScriptBracketText" Text=""
                                           FontFamily="{DynamicResource MonoFont}" FontSize="7"
                                           Foreground="{DynamicResource TextDisabledBrush}"
                                           Margin="0,0,10,0" />
                                <TextBlock x:Name="ScriptLineInfo"
                                           FontFamily="{DynamicResource MonoFont}" FontSize="7.5"
                                           Foreground="{DynamicResource TextDisabledBrush}"
                                           Text="0 行" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}"
                            Margin="12,0" />

                    <!-- Output console -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="24" CornerRadius="6"
                                        Background="{DynamicResource InsetSurfaceStrongBrush}">
                                    <TextBlock Text="&#xE756;" FontFamily="{DynamicResource IconFont}"
                                               FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="运行输出" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" Margin="7,0,0,0" />
                                <Ellipse Width="4" Height="4" Margin="8,0,0,0"
                                         Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="OutputStatusText" Text="就绪"
                                           FontFamily="{DynamicResource MonoFont}" FontSize="7.5"
                                           Margin="5,0,0,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Style="{StaticResource MiniActionButtonStyle}" Content="清空"
                                    HorizontalAlignment="Right" Click="ClearOutput_OnClick" />
                        </Grid>
                        <Border Grid.Row="1" Margin="0,8,0,0"
                                Background="#21000000"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <TextBox x:Name="OutputTextBox"
                                     Style="{StaticResource ConsoleTextBoxStyle}" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= Status bar ================= -->
            <Border Grid.Row="3"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource SuccessBrush}"
                                 Margin="0,0,6,0" />
                        <TextBlock x:Name="StatusText" Text="就绪 · 已载入示例设计"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="7.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusSelectionText" Text="窗口属性"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="7.5"
                                   Foreground="{DynamicResource TextDisabledBrush}" />
                        <TextBlock Text="  ·  " FontFamily="{DynamicResource MonoFont}" FontSize="7.5"
                                   Foreground="{DynamicResource TextDisabledBrush}" />
                        <TextBlock Text="{Binding ControlCountText}"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="7.5"
                                   Foreground="{DynamicResource TextDisabledBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="AutosaveStatusText" Text=""
                                   FontFamily="{DynamicResource MonoFont}" FontSize="7.5"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   Margin="0,0,10,0" />
                        <TextBlock Text="适应窗口" FontFamily="{DynamicResource MonoFont}" FontSize="7.5"
                                   Foreground="{DynamicResource TextDisabledBrush}" />
                        <TextBlock Text="  ·  FROSTUI 1.0" FontFamily="{DynamicResource MonoFont}" FontSize="7.5"
                                   Foreground="{DynamicResource TextDisabledBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Popup x:Name="LayersPopup"
               PlacementTarget="{Binding ElementName=LayersButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               HorizontalOffset="-150"
               VerticalOffset="6">
            <Border Width="324" Height="438"
                    Background="{DynamicResource ToastBrush}"
                    BorderBrush="{DynamicResource CardBorderStrongBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="11">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="9" Direction="270"
                                      Color="#A0000000" Opacity="0.46" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="图层" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="LayerCountText" FontFamily="{DynamicResource MonoFont}"
                                       FontSize="7.5" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="底层 → 顶层" HorizontalAlignment="Right"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="7"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,9,0,7">
                        <TextBox x:Name="LayerSearchBox"
                                 Style="{StaticResource GlassTextBoxStyle}" Height="28"
                                 FontSize="9" Padding="8,0" VerticalContentAlignment="Center"
                                 TextChanged="LayerSearchBox_OnTextChanged"
                                 ToolTip="按名称或类型搜索图层" />
                        <TextBlock Text="搜索名称或类型…" Margin="10,0,0,0"
                                   FontSize="8.5"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=LayerSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ListBox x:Name="LayerList" Grid.Row="2"
                             Style="{StaticResource LayerListStyle}"
                             SelectionChanged="LayerList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid AutomationProperties.Name="{Binding Name}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="23" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding KindIcon}" FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="4,0,5,0">
                                        <TextBlock Text="{Binding Name}" FontSize="9.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding KindTitle}" FontSize="7.5"
                                                   Foreground="{DynamicResource TextDisabledBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                                            Width="22" Height="22" Padding="0"
                                            FontFamily="{DynamicResource UiFont}"
                                            Content="{Binding VisibilityLabel}" FontSize="8"
                                            Tag="visibility" Click="LayerVisibility_OnClick"
                                            ToolTip="显示 / 隐藏" />
                                    <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                                            Width="22" Height="22" Padding="0"
                                            FontFamily="{DynamicResource UiFont}"
                                            Content="{Binding LockLabel}" FontSize="8"
                                            Tag="lock" Click="LayerLock_OnClick"
                                            ToolTip="锁定 / 解锁" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="3" Margin="0,7,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource MiniActionButtonStyle}" Content="上移"
                                    Tag="up" Click="LayerOrder_OnClick" />
                            <Button Style="{StaticResource MiniActionButtonStyle}" Content="下移"
                                    Tag="down" Click="LayerOrder_OnClick" />
                        </StackPanel>
                        <TextBlock Text="Ctrl 多选" HorizontalAlignment="Right"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="7"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Popup>

        <Popup x:Name="AlignPopup"
               PlacementTarget="{Binding ElementName=AlignButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               HorizontalOffset="-120"
               VerticalOffset="6">
            <Border Width="286" Background="{DynamicResource ToastBrush}"
                    BorderBrush="{DynamicResource CardBorderStrongBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="11">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270"
                                      Color="#A0000000" Opacity="0.45" />
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <TextBlock Text="对齐与分布" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="选中 2 个以上控件" HorizontalAlignment="Right"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="7"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <UniformGrid Columns="3" Margin="0,8,0,0">
                        <Button Style="{StaticResource MiniActionButtonStyle}" Content="左对齐" Tag="left" Click="AlignAction_OnClick" />
                        <Button Style="{StaticResource MiniActionButtonStyle}" Content="水平居中" Tag="centerX" Click="AlignAction_OnClick" />
                        <Button Style="{StaticResource MiniActionButtonStyle}" Content="右对齐" Tag="right" Click="AlignAction_OnClick" />
                        <Button Style="{StaticResource MiniActionButtonStyle}" Content="顶对齐" Tag="top" Click="AlignAction_OnClick" />
                        <Button Style="{StaticResource MiniActionButtonStyle}" Content="垂直居中" Tag="centerY" Click="AlignAction_OnClick" />
                        <Button Style="{StaticResource MiniActionButtonStyle}" Content="底对齐" Tag="bottom" Click="AlignAction_OnClick" />
                    </UniformGrid>
                    <Grid Margin="0,5,0,0">
                        <Button Style="{StaticResource MiniActionButtonStyle}" Content="横向等距"
                                HorizontalAlignment="Left" Tag="distributeX" Click="AlignAction_OnClick" />
                        <Button Style="{StaticResource MiniActionButtonStyle}" Content="纵向等距"
                                HorizontalAlignment="Right" Tag="distributeY" Click="AlignAction_OnClick" />
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <Grid x:Name="CommandPaletteOverlay"
              Background="#72000000"
              Panel.ZIndex="200"
              Visibility="Collapsed">
            <Border Width="580" MaxHeight="470" Margin="0,92,0,0"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    Background="{DynamicResource ToastBrush}"
                    BorderBrush="{DynamicResource CardBorderStrongBrush}"
                    BorderThickness="1" CornerRadius="11" Padding="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="12" Direction="270"
                                      Color="#B0000000" Opacity="0.55" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="CommandSearchBox"
                             Style="{StaticResource GlassTextBoxStyle}"
                             Height="34" FontSize="11" Padding="10,0"
                             VerticalContentAlignment="Center"
                             TextChanged="CommandSearchBox_OnTextChanged"
                             PreviewKeyDown="CommandSearchBox_OnPreviewKeyDown"
                             ToolTip="搜索命令" />
                    <ListBox x:Name="CommandList" Grid.Row="1" Margin="0,8,0,0"
                             Style="{StaticResource LayerListStyle}"
                             MouseDoubleClick="CommandList_OnMouseDoubleClick"
                             PreviewKeyDown="CommandList_OnPreviewKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="9.5"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Hint}" HorizontalAlignment="Right"
                                               FontFamily="{DynamicResource MonoFont}" FontSize="7"
                                               Foreground="{DynamicResource TextDisabledBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="↑↓ 选择 · Enter 执行 · Esc 关闭"
                               FontFamily="{DynamicResource MonoFont}" FontSize="7"
                               Foreground="{DynamicResource TextDisabledBrush}"
                               Margin="0,8,0,0" />
                </Grid>
            </Border>
        </Grid>

        <Popup x:Name="ScriptDocPopup"
               Placement="Mouse"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border MaxWidth="430" Background="{DynamicResource ToastBrush}"
                    BorderBrush="{DynamicResource AccentBorderBrush}"
                    BorderThickness="1" CornerRadius="7" Padding="9,6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="6" Direction="270"
                                      Color="#90000000" Opacity="0.4" />
                </Border.Effect>
                <TextBlock x:Name="ScriptDocText" FontSize="8.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
        </Popup>

        <Popup x:Name="ComponentsPopup"
               PlacementTarget="{Binding ElementName=ComponentsButton}"
               Placement="Right"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               HorizontalOffset="8"
               VerticalOffset="-8">
            <Border Width="300" Height="512" Background="{DynamicResource ToastBrush}"
                    BorderBrush="{DynamicResource CardBorderStrongBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="11">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270"
                                      Color="#A0000000" Opacity="0.45" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="组件 / 片段库" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="插入为独立副本" HorizontalAlignment="Right"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="7"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,8,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ComponentNameBox" Style="{StaticResource GlassTextBoxStyle}"
                                 Height="28" FontSize="9" Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="组件名称 / 重命名" />
                        <Button Grid.Column="1" Style="{StaticResource MiniActionButtonStyle}"
                                Content="保存选中" Margin="5,0,0,0"
                                Click="SaveComponent_OnClick" />
                    </Grid>
                    <TextBox x:Name="ComponentSearchBox" Grid.Row="2"
                             Style="{StaticResource GlassTextBoxStyle}"
                             Height="26" FontSize="8" Padding="8,0"
                             Margin="0,0,0,5"
                             VerticalContentAlignment="Center"
                             TextChanged="ComponentSearchBox_OnTextChanged"
                             ToolTip="搜索组件" />
                    <TextBox x:Name="ComponentVariantBox" Grid.Row="3"
                             Style="{StaticResource GlassTextBoxStyle}"
                             Height="26" FontSize="8" Padding="8,0"
                             Margin="0,0,0,7"
                             VerticalContentAlignment="Center"
                             ToolTip="变体名（可选，例如 主要）" />
                    <ListBox x:Name="ComponentList" Grid.Row="4"
                             Style="{StaticResource LayerListStyle}"
                             MouseDoubleClick="ComponentList_OnMouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="9"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="5" Margin="0,7,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Content="插入" Click="InsertComponent_OnClick" />
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Content="重命名" Margin="5,0,0,0" Click="RenameComponent_OnClick" />
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Content="删除" Margin="5,0,0,0" Click="DeleteComponent_OnClick" />
                        </StackPanel>
                        <TextBlock x:Name="ComponentCountText" Text="双击插入" HorizontalAlignment="Right"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="7"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="6" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Content="刷新" Click="RefreshComponents_OnClick" />
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Content="复制" Margin="5,0,0,0" Click="DuplicateComponent_OnClick" />
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Content="导入" Margin="5,0,0,0" Click="ImportComponent_OnClick" />
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Content="导出" Margin="5,0,0,0" Click="ExportComponent_OnClick" />
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Content="目录" Margin="5,0,0,0" Click="OpenComponentsFolder_OnClick" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="7" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Content="插入实例" Click="InsertComponentInstance_OnClick" />
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Content="刷新实例" Margin="5,0,0,0" Click="RefreshComponentInstance_OnClick" />
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Content="分离实例" Margin="5,0,0,0" Click="DetachComponentInstance_OnClick" />
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Content="记录覆盖" Margin="5,0,0,0" Click="CaptureInstanceOverride_OnClick" />
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Content="清覆盖" Margin="5,0,0,0" Click="ClearInstanceOverride_OnClick" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Popup>

        <Popup x:Name="FindReplacePopup"
               PlacementTarget="{Binding ElementName=ScriptFindButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               HorizontalOffset="-245"
               VerticalOffset="4">
            <Border Width="380" Background="{DynamicResource ToastBrush}"
                    BorderBrush="{DynamicResource CardBorderStrongBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270"
                                      Color="#A0000000" Opacity="0.45" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="查找 / 替换" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FindBox" Style="{StaticResource GlassTextBoxStyle}"
                                 Height="28" FontSize="9" Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 KeyDown="FindBox_OnKeyDown"
                                 ToolTip="要查找的文本" />
                        <Button Grid.Column="1" Style="{StaticResource MiniActionButtonStyle}"
                                Content="下一个" Tag="next" Click="FindAction_OnClick"
                                Margin="6,0,0,0" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ReplaceBox" Style="{StaticResource GlassTextBoxStyle}"
                                 Height="28" FontSize="9" Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="替换为（留空表示删除）" />
                        <Button Grid.Column="1" Style="{StaticResource MiniActionButtonStyle}"
                                Content="替换" Tag="replace" Click="FindAction_OnClick"
                                Margin="6,0,0,0" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Content="全部替换" Tag="replaceAll" Click="FindAction_OnClick" />
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Content="关闭" Click="CloseFindReplace_OnClick" />
                        </StackPanel>
                        <TextBlock x:Name="FindStatusText" HorizontalAlignment="Right"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="7"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="ScriptDiagnosticsPopup"
               PlacementTarget="{Binding ElementName=ScriptDiagnosticsText}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               HorizontalOffset="-210"
               VerticalOffset="4">
            <Border Width="430" MaxHeight="260" Background="{DynamicResource ToastBrush}"
                    BorderBrush="{DynamicResource CardBorderStrongBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270"
                                      Color="#A0000000" Opacity="0.45" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="脚本问题" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="双击跳转到行" HorizontalAlignment="Right"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="7"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ListBox x:Name="ScriptDiagnosticsList" Grid.Row="1" Margin="0,7,0,0"
                             Style="{StaticResource DiagnosticsListStyle}"
                             MouseDoubleClick="ScriptDiagnosticsList_OnMouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontSize="9"
                                               Foreground="{DynamicResource WarningBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="8.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>

        <Popup x:Name="HistoryPopup"
               PlacementTarget="{Binding ElementName=HistoryButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               HorizontalOffset="-180"
               VerticalOffset="6">
            <Border Width="310" Height="386" Background="{DynamicResource ToastBrush}"
                    BorderBrush="{DynamicResource CardBorderStrongBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="11">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270"
                                      Color="#A0000000" Opacity="0.45" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="编辑历史" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="HistoryCountText" HorizontalAlignment="Right"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="7"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ListBox x:Name="HistoryList" Grid.Row="1" Margin="0,8,0,0"
                             Style="{StaticResource HistoryListStyle}"
                             SelectionChanged="HistoryList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid AutomationProperties.Name="{Binding Label}">
                                    <TextBlock Text="{Binding Label}" FontSize="9"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TimestampText}" HorizontalAlignment="Right"
                                               FontFamily="{DynamicResource MonoFont}" FontSize="7"
                                               Foreground="{DynamicResource TextDisabledBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="撤销 Ctrl+Z · 重做 Ctrl+Y"
                               FontFamily="{DynamicResource MonoFont}" FontSize="7"
                               Foreground="{DynamicResource TextDisabledBrush}"
                               Margin="0,7,0,0" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</ui:FrostWindow>
