<ui:FrostWindow x:Class="FrostUI.Designer.Views.ExportDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:FrostUI.Controls;assembly=FrostUI"
                Title="导出 Release"
                Width="720" Height="590"
                MinWidth="620" MinHeight="480"
                WindowStartupLocation="CenterOwner"
                ShowInTaskbar="False"
                Backdrop="Acrylic"
                TintOpacity="0.32"
                Style="{StaticResource FrostWindowStyle}">
    <ui:FrostWindow.TitleBarContent>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="{DynamicResource AccentSoftBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="7,2">
                <TextBlock Text="EXPORT" FontFamily="{DynamicResource MonoFont}"
                           FontSize="7.5" Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <TextBlock Text="发布为独立 release" FontSize="9.5" Margin="8,0,0,0"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>
    </ui:FrostWindow.TitleBarContent>

    <Grid Margin="26,18,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="导出独立应用" FontSize="23" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock x:Name="ProjectSummaryText"
                       FontSize="9.5" Margin="0,5,0,0"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
            <TextBlock Text="会把当前窗口、控件和脚本发布成一个可直接运行的文件夹，并写入 design.frostui.json。"
                       FontSize="9" Margin="0,3,0,0"
                       Foreground="{DynamicResource TextDisabledBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="导出到" FontSize="9" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="1,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DestinationBox"
                         Style="{StaticResource GlassTextBoxStyle}"
                         Height="34" Padding="10,0" VerticalContentAlignment="Center"
                         FontFamily="{DynamicResource MonoFont}" FontSize="9.5" />
                <Button Grid.Column="1" Content="浏览…"
                        Style="{StaticResource GhostButtonStyle}"
                        Height="34" MinWidth="68" Padding="10,0" Margin="8,0,0,0"
                        Click="Browse_OnClick" />
            </Grid>
            <TextBlock Text="默认导出到当前运行目录；也可以改选一个空文件夹。发布过程会写入 Player 运行时、design.frostui.json 和启动脚本。"
                       FontSize="8" Margin="1,5,0,0"
                       Foreground="{DynamicResource TextDisabledBrush}" />

            <TextBlock Text="发布方式" Style="{StaticResource InspectorLabelStyle}" Margin="1,12,0,0" />
            <ComboBox x:Name="PublishModeBox" Height="32" Margin="0,4,0,0"
                      SelectionChanged="PublishModeBox_OnSelectionChanged">
                <ComboBoxItem Content="内置模板 · 单文件（推荐，无需 SDK）" />
                <ComboBoxItem Content="内置模板 · 文件夹（无需 SDK）" />
                <ComboBoxItem Content="开发者编译（需要源码和 .NET SDK）" />
            </ComboBox>

            <StackPanel Orientation="Horizontal" Margin="1,10,0,0">
                <CheckBox x:Name="SelfContainedCheck"
                          Content="自包含运行时（无需安装 .NET，体积约 100+ MB）"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          FontSize="9" IsChecked="True" />
                <CheckBox x:Name="OpenFolderCheck"
                          Content="完成后打开文件夹"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          FontSize="9" IsChecked="True" Margin="24,0,0,0" />
            </StackPanel>

            <CheckBox x:Name="SingleFileCheck"
                      Content="单文件发布（启动稍慢，生成的 EXE 更大）"
                      Foreground="{DynamicResource TextSecondaryBrush}"
                      FontSize="9" IsChecked="False" Margin="1,8,0,0" />
            <CheckBox x:Name="ReadyToRunCheck"
                      Content="ReadyToRun（启动更快，体积约增加 20–40%）"
                      Foreground="{DynamicResource TextSecondaryBrush}"
                      FontSize="9" IsChecked="False" Margin="1,6,0,0" />

            <Border Background="{DynamicResource InsetSurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1" CornerRadius="7"
                    Padding="10,7" Margin="0,12,0,0">
                <TextBlock Text="框架依赖模式更快、文件夹更小，但目标机器需要 .NET 9 Desktop Runtime；自包含模式可以直接复制到别的 Windows 机器运行。"
                           FontSize="8" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="发布日志" FontSize="9" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock x:Name="StatusText" Text="就绪" FontFamily="{DynamicResource MonoFont}"
                           FontSize="8" Margin="8,0,0,0"
                           Foreground="{DynamicResource TextDisabledBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <Border Grid.Row="1" Margin="0,6,0,0"
                    Background="#21000000"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="7">
                <TextBox x:Name="LogBox" Style="{StaticResource ConsoleTextBoxStyle}"
                         IsReadOnly="True" FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CloseButton" Content="关闭"
                    Style="{StaticResource GhostButtonStyle}"
                    Height="32" MinWidth="70" Padding="12,0"
                    Click="Close_OnClick" />
            <Button x:Name="ExportButton" Content="开始导出"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="32" MinWidth="96" Padding="14,0" Margin="8,0,0,0"
                    Click="Export_OnClick" />
        </StackPanel>
    </Grid>
</ui:FrostWindow>
