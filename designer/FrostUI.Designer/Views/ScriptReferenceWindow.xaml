<ui:FrostWindow x:Class="FrostUI.Designer.Views.ScriptReferenceWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:FrostUI.Controls;assembly=FrostUI"
                Title="脚本参考"
                Width="820" Height="640"
                MinWidth="680" MinHeight="460"
                WindowStartupLocation="CenterOwner"
                ShowInTaskbar="False"
                Backdrop="Acrylic"
                TintOpacity="0.30"
                Style="{StaticResource FrostWindowStyle}">
    <ui:FrostWindow.TitleBarContent>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="{DynamicResource AccentSoftBrush}"
                    BorderBrush="{DynamicResource AccentBorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="7,2">
                <TextBlock Text="REFERENCE" FontFamily="{DynamicResource MonoFont}"
                           FontSize="7" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>
            <TextBlock Text="脚本函数 / 控件能力对照"
                       FontSize="9.5" Margin="8,0,0,0"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
    </ui:FrostWindow.TitleBarContent>

    <Grid Margin="22,14,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource GlassTextBoxStyle}"
                     Height="32" FontSize="10" Padding="10,0"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchBox_OnTextChanged"
                     ToolTip="搜索函数、关键字、控件或说明" />
            <ComboBox x:Name="CategoryBox" Grid.Column="2" Height="32" FontSize="9"
                      SelectionChanged="CategoryBox_OnSelectionChanged" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0"
                        VerticalAlignment="Center">
                <ui:GlassToggleSwitch x:Name="PinToggle" Width="42" Height="23"
                                      IsChecked="False"
                                      Checked="PinToggle_OnChanged"
                                      Unchecked="PinToggle_OnChanged" />
                <TextBlock Text="置顶" FontSize="9" Margin="7,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#21000000" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="3">
                <ListBox x:Name="ReferenceList" Style="{StaticResource LayerListStyle}"
                         SelectionChanged="ReferenceList_OnSelectionChanged"
                         MouseDoubleClick="ReferenceList_OnMouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="9.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Category}" HorizontalAlignment="Right"
                                               FontSize="7.5"
                                               Foreground="{DynamicResource TextDisabledBrush}" />
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding Signature}"
                                           FontFamily="{DynamicResource MonoFont}" FontSize="7.5"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Background="#21000000"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="13">
                <StackPanel>
                    <TextBlock x:Name="DetailName" Text="选择左侧条目"
                               FontFamily="{DynamicResource DisplayFont}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailCategory" Text=""
                               FontSize="8" Margin="0,4,0,0"
                               Foreground="{DynamicResource AccentBrush}" />
                    <Border Background="{DynamicResource InsetSurfaceBrush}"
                            CornerRadius="6" Padding="8" Margin="0,10,0,0">
                        <TextBlock x:Name="DetailSignature" Text=""
                                   FontFamily="{DynamicResource MonoFont}" FontSize="8"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                    <TextBlock x:Name="DetailDescription" Text=""
                               FontSize="9" LineHeight="16" Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,9,0,0">
            <TextBlock x:Name="CountText" Text="" FontFamily="{DynamicResource MonoFont}"
                       FontSize="8" Foreground="{DynamicResource TextDisabledBrush}"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButtonStyle}" Content="插入到脚本"
                        Height="30" MinWidth="94" Click="Insert_OnClick" />
                <Button Style="{StaticResource GhostButtonStyle}" Content="关闭"
                        Height="30" MinWidth="64" Margin="7,0,0,0" Click="Close_OnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FrostWindow>
