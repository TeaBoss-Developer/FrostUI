<ui:FrostWindow x:Class="FrostUI.Designer.Views.PreviewWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:FrostUI.Controls;assembly=FrostUI"
                Title="FrostUI 预览"
                Width="980" Height="620"
                WindowStartupLocation="CenterOwner"
                ShowInTaskbar="False"
                Style="{StaticResource FrostWindowStyle}"
                Backdrop="Acrylic"
                TintOpacity="0.28"
                FontFamily="{DynamicResource UiFont}">
    <ui:FrostWindow.TitleBarContent>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="PreviewBadge"
                    Background="{DynamicResource SuccessSoftBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="7,2">
                <TextBlock Text="PREVIEW"
                           FontFamily="{DynamicResource MonoFont}"
                           FontSize="7.5"
                           Foreground="{DynamicResource SuccessBrush}" />
            </Border>
            <TextBlock x:Name="PreviewTitleHint"
                       Text="交互预览 · 关闭返回设计器"
                       FontSize="9.5"
                       Margin="8,0,0,0"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>
    </ui:FrostWindow.TitleBarContent>

    <Grid>
        <Viewbox x:Name="PreviewScaler" Stretch="None" StretchDirection="Both"
                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                 SizeChanged="PreviewScaler_OnSizeChanged">
            <Canvas x:Name="PreviewCanvas" Background="Transparent" ClipToBounds="True" />
        </Viewbox>

        <Grid x:Name="DialogOverlay" Visibility="Collapsed" Panel.ZIndex="40"
              Background="#88000000">
            <Border x:Name="OverlayDialogBorder"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="900" MaxHeight="700"
                    Background="{DynamicResource ToastBrush}"
                    BorderBrush="{DynamicResource CardBorderStrongBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="4,0,4,8">
                        <TextBlock x:Name="OverlayTitle" Text="弹窗"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource GhostButtonStyle}"
                                Height="24" Padding="8,0" Content="关闭"
                                Click="CloseOverlay_OnClick" />
                    </Grid>
                    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly">
                        <Canvas x:Name="OverlayCanvas" Width="640" Height="420"
                                Background="Transparent" ClipToBounds="True" />
                    </Viewbox>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="ToastHost"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,22"
                Padding="12,8"
                CornerRadius="9"
                Background="{DynamicResource ToastBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                Opacity="0"
                IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTransform" Y="8" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="8" Direction="270"
                                  Color="#A0000000" Opacity="0.4" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Border Width="20" Height="20" CornerRadius="6"
                        Background="{DynamicResource AccentSoftBrush}"
                        Margin="0,0,8,0">
                    <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource IconFont}"
                               FontSize="8" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="ToastText" Text=""
                           FontSize="10.5"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FrostWindow>
