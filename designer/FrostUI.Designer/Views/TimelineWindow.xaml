<ui:FrostWindow x:Class="FrostUI.Designer.Views.TimelineWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:FrostUI.Controls;assembly=FrostUI"
                Title="动画时间线"
                Width="900" Height="580"
                MinWidth="720" MinHeight="460"
                WindowStartupLocation="CenterOwner"
                ShowInTaskbar="False"
                Backdrop="Acrylic"
                TintOpacity="0.30"
                Style="{StaticResource FrostWindowStyle}">
    <ui:FrostWindow.TitleBarContent>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="{DynamicResource AccentSoftBrush}"
                    BorderBrush="{DynamicResource AccentBorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="7,2">
                <TextBlock Text="TIMELINE" FontFamily="{DynamicResource MonoFont}"
                           FontSize="7" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>
            <TextBlock x:Name="TargetText" FontSize="9.5" Margin="8,0,0,0"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
    </ui:FrostWindow.TitleBarContent>

    <Grid Margin="20,14,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="轨迹" Style="{StaticResource InspectorLabelStyle}" />
        <Border Grid.Row="1" Margin="0,5,0,0" Height="94"
                Background="#21000000" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="8">
            <Canvas x:Name="TrackCanvas" Margin="10" Height="72"
                    HorizontalAlignment="Stretch" ClipToBounds="True" />
        </Border>

        <Grid Grid.Row="2" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="PropertyBox" Height="30" FontSize="9" />
            <TextBox x:Name="TimeBox" Grid.Column="1" Margin="6,0,0,0" Height="30"
                     Style="{StaticResource GlassTextBoxStyle}" FontSize="9"
                     ToolTip="时间 ms" />
            <TextBox x:Name="ValueBox" Grid.Column="2" Margin="6,0,0,0" Height="30"
                     Style="{StaticResource GlassTextBoxStyle}" FontSize="9"
                     ToolTip="值：透明度 0–1；X/Y 为绝对坐标；缩放为倍数；旋转为角度" />
            <ComboBox x:Name="EasingBox" Grid.Column="3" Margin="6,0,0,0" Height="30" FontSize="9" />
            <Button Grid.Column="4" Content="添加关键帧" Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButtonStyle}" Height="30"
                    Click="Add_OnClick" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#21000000" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="3">
                <ListBox x:Name="KeyframeList" Style="{StaticResource LayerListStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="3,1">
                                <TextBlock Text="{Binding Property}" FontSize="9"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding TimeMs, StringFormat={}{0} ms}"
                                           HorizontalAlignment="Center" FontFamily="{DynamicResource MonoFont}"
                                           FontSize="8" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding Value}" HorizontalAlignment="Right"
                                           FontFamily="{DynamicResource MonoFont}" FontSize="8"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <StackPanel Grid.Column="2">
                <Button Content="删除选中关键帧" Style="{StaticResource GhostButtonStyle}"
                        Height="30" Click="Delete_OnClick" />
                <TextBlock Text="X/Y 使用绝对坐标，播放时转换为相对偏移；Opacity 0–1；Scale 1=原尺寸；Rotation 角度。"
                           FontSize="8" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <TextBlock x:Name="CountText" FontFamily="{DynamicResource MonoFont}" FontSize="8"
                       Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="预览" Style="{StaticResource PrimaryButtonStyle}"
                        Height="30" MinWidth="70" Click="Preview_OnClick" />
                <Button Content="关闭" Style="{StaticResource GhostButtonStyle}"
                        Height="30" MinWidth="64" Margin="7,0,0,0" Click="Close_OnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FrostWindow>
