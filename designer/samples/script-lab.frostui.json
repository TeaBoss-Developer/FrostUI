    {
      "name": "按钮_计数",
      "kind": "button",
      "x": 60,
      "y": 150,
      "width": 116,
      "height": 36,
      "text": "点击计数",
      "fontSize": 13,
      "isBold": false,
      "isVisible": true,
      "isEnabled": true,
      "isLocked": false,
      "isOn": false,
      "value": 50,
      "cornerRadius": 16,
      "scripts": {
        "点击": "// 点击计数：全局变量在本次预览中持续存在\n全局 计数: 整数 = 0\n全局 计数 = 计数 + 1\n设 结果: 文本 = \"点击次数：\" + 文本(计数)\n标签_结果.文本 = 结果\n如果 (计数 >= 5) {\n    标签_结果.文本 = 结果 + \" · 达标\"\n}\n输出(\"按钮_计数 => \" + 结果)"
      }
    },
    {
      "name": "按钮_JSON",
      "kind": "button",
      "x": 188,
      "y": 150,
      "width": 116,
      "height": 36,
      "text": "解析 JSON",
      "fontSize": 13,
      "isBold": false,
      "isVisible": true,
      "isEnabled": true,
      "isLocked": false,
      "isOn": false,
      "value": 50,
      "cornerRadius": 16,
      "scripts": {
        "点击": "// 离线 JSON 解析：对象、数组与类型转换\n设 原始: 文本 = \"{\\\"name\\\":\\\"FrostUI\\\",\\\"version\\\":1.0,\\\"features\\\":[\\\"Acrylic\\\",\\\"Mica\\\",\\\"Script\\\"]}\"\n设 数据: JSON = JSON.解析(原始)\n设 名称: 文本 = 文本(JSON.取值(数据, \"name\"))\n设 特性: 文本 = 文本(JSON.取值(数据, \"features[1]\"))\n标签_结果.文本 = \"JSON：\" + 名称 + \" · \" + 特性\n输出(\"JSON 解析成功：\" + 名称 + \" / \" + 特性)"
      }
    },
    {
      "name": "按钮_API",
      "kind": "button",
      "x": 316,
      "y": 150,
      "width": 116,
      "height": 36,
      "text": "请求 API",
      "fontSize": 13,
      "isBold": false,
      "isVisible": true,
      "isEnabled": true,
      "isLocked": false,
      "isOn": false,
      "value": 50,
      "cornerRadius": 16,
      "scripts": {
        "点击": "// 真实 HTTP GET，并把 JSON 字段写入界面\n提示(\"正在请求 GitHub API…\")\n设 响应: JSON = HTTP.获取JSON(\"https://api.github.com/repos/dotnet/wpf\")\n设 名称: 文本 = 文本(JSON.取值(响应, \"full_name\"))\n设 星数: 文本 = 文本(JSON.取值(响应, \"stargazers_count\"))\n标签_结果.文本 = \"API：\" + 名称 + \" · ★ \" + 星数\n输出(\"API 请求成功：\" + 名称)"
      }
    },
